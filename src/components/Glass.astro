---
// A large Elm Labs leaf seen through a panel of reeded glass, drawn behind the hero with WebGL2.
//
// The glass is a row of vertical strips. Each strip is a half-cylinder lens, so it shows a squeezed,
// shifted slice of what is behind it, and neighbouring strips show overlapping slices. That repeats
// the edges of the leaf across the strips. Per pixel the shader:
// 1. works out which strip the pixel is in and how far across it (0 at the left edge, 1 at the right),
// 2. moves the point it looks up sideways by an amount that grows toward the strip's edges,
//    a little more for red and a little less for blue, so the edges split slightly into colour,
// 3. reads the leaf there, blurred more toward the strip's edges and where the glass is frosted,
// 4. shades the strip: lighter on the left, a thin highlight, and a dark hairline where strips meet.
//
// The blur. At load the leaf is blurred once on the GPU into six layers of one texture, each with a
// Gaussian blur twice as wide as the last. Per pixel the shader blends the two layers nearest the blur
// it wants. Reading the texture's built-in shrunk copies (mipmaps) instead looked blocky: the GPU
// stretches a 32px copy back up with straight-line blends between texels, and the steps show.
//
// The leaf sways slowly and leans toward the cursor on a spring, so the slices slide across the strips.
// It runs only while <html data-bg> is "glass" (see BgToggle.astro) and the canvas is on screen.
// Without WebGL2 the canvas stays hidden and the hero keeps the plain paper background.
interface Props { target?: string }
const { target = '.hero' } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---
<canvas class="glass" id="glass" data-target={target} data-leaf={`${base}logofilledwhite.svg`} aria-hidden="true"></canvas>

<style>
	.glass{position:absolute;top:0;left:0;width:100%;height:0;z-index:-1;pointer-events:none;opacity:0;transition:opacity 1.4s ease}
	.glass.on{opacity:1}
</style>

<script is:inline>
addEventListener('DOMContentLoaded', () => {
	const cv = document.getElementById('glass');
	const hero = document.querySelector(cv.dataset.target);
	const gl = cv.getContext('webgl2', { alpha: false, antialias: false, depth: false, stencil: false, preserveDrawingBuffer: false });
	if (!gl || !hero) return;

	// Tuning. Lengths are css px.
	const STRIP = 51;         // width of one glass strip
	const BEND = 1.1;         // how far each strip shifts what is behind it; 0 is flat glass
	const SPLIT = 0.05;       // how much red and blue bend differently from green
	const BLUR = [0.5, 1.5];  // blur at the centre and at the edges of a strip (Gaussian sigma, css px)
	const FROST = 1.5;        // strength of the frosting at the left of the glass; it clears toward the right edge
	const FROST_BLUR = 10;    // blur that full frosting adds (sigma, css px)
	const HALO = 22;          // blur of the leaf's soft shadow on the paper (sigma, css px)
	const REVEAL = [0.45, 0.68];  // the glass fades in between these shares of the page width, so the headline sits on plain paper
	const EXTRA = 110;        // how far the glass runs past the bottom of the hero
	const FADE = 260;         // length of the fade back to paper at the bottom
	const SWAY = 16;          // how far the leaf drifts on its own
	const LEAN = 40;          // how far the leaf leans toward the cursor
	const MAX_PIXELS = 3.5e6;
	const still = matchMedia('(prefers-reduced-motion: reduce)').matches;

	const VS = `#version 300 es
	in vec2 a; void main(){ gl_Position = vec4(a, 0., 1.); }`;

	const FS = `#version 300 es
	precision highp float;
	precision highp sampler2DArray;
	uniform vec2 uSize; uniform float uDpr, uTime, uFade, uStrip, uBend, uSplit, uFrost, uFrostBlur, uHalo;
	uniform vec2 uBlur, uReveal;   // uReveal: where the glass starts and where it is full strength (css px)
	uniform sampler2DArray uLeaf; uniform float uLeafOn;
	uniform float uS1, uTop;       // blur of layer 1 (texture widths); index of the last layer
	uniform vec4 uPlace;   // leaf centre (css px, y up), height, angle
	uniform float uAlpha;  // how strongly the leaf shows; lower on phones, where the text covers it
	out vec4 o;

	float hash(vec2 p){ p = fract(p * vec2(123.34, 456.21)); p += dot(p, p + 45.32); return fract(p.x * p.y); }

	vec2 leafUV(vec2 q){
		vec2 d = q - uPlace.xy;
		float c = cos(uPlace.w), s = sin(uPlace.w);
		return mat2(c, -s, s, c) * d / uPlace.z + 0.5;
	}
	// The leaf at a point (css px): its coverage, with a Gaussian blur of sigma px.
	// Layer 0 is sharp and layer k has sigma uS1 * 2^(k-1), so the layer index is a log of the blur.
	float leafA(vec2 q, float px){
		vec2 uv = leafUV(q);
		float s = px / uPlace.z;
		float f = clamp(s < uS1 ? s / uS1 : 1. + log2(s / uS1), 0., uTop);
		float l = floor(f);
		return mix(texture(uLeaf, vec3(uv, l)).r, texture(uLeaf, vec3(uv, min(l + 1., uTop))).r, f - l);
	}

	void main(){
		vec2 p = gl_FragCoord.xy / uDpr;   // css px, origin bottom-left
		float yTop = uSize.y - p.y;
		vec3 paper = vec3(0.965, 0.941, 0.894);

		// Where this pixel sits in its strip: u runs 0 to 1 across it, n runs -1 to 1.
		float u = fract(p.x / uStrip), n = u * 2. - 1.;
		// How much glass there is here: none on the left, full by uReveal.y.
		float g = smoothstep(uReveal.x, uReveal.y, p.x);
		// A cylinder lens bends light most at its edges. sin() gives that shape.
		float shift = sin(n * 1.5707963) * 0.5 * uStrip * uBend * g;
		// Frosting: strongest where the glass starts, clear at the right edge of the page.
		float frost = g * (1. - smoothstep(uReveal.x, uSize.x, p.x)) * uFrost;
		float blur = mix(uBlur.x, uBlur.y, n * n) * g + frost * uFrostBlur;
		// Frosted glass scatters light, so each pixel looks up the leaf about a px away in a random,
		// fixed direction. That gives a very fine grain on top of the blur.
		vec2 grain = (vec2(hash(gl_FragCoord.xy), hash(gl_FragCoord.yx + 17.)) - 0.5) * 1.5 * frost;
		p += grain;

		vec3 a = vec3(0.);
		if (uLeafOn > 0.5) {
			a.r = leafA(p + vec2(shift * (1. + uSplit), 0.), blur);
			a.g = leafA(p + vec2(shift, 0.), blur);
			a.b = leafA(p + vec2(shift * (1. - uSplit), 0.), blur);
		}
		float halo = uLeafOn > 0.5 ? leafA(p + vec2(shift * 0.6, 0.), uHalo) : 0.;

		// The leaf: deep green, lighter toward the top, with a pale green sheen that drifts slowly
		// across it, like light passing behind it.
		vec2 lu = leafUV(p + vec2(shift, 0.));
		vec3 deep = vec3(0.105, 0.290, 0.214), mid = vec3(0.180, 0.478, 0.368), pale = vec3(0.420, 0.650, 0.540);
		vec3 leaf = mix(deep, mid, smoothstep(0.1, 0.95, lu.y * 0.7 + (1. - lu.x) * 0.3));
		float glow = smoothstep(0.5, 0., length(lu - vec2(0.62 + 0.12 * sin(uTime * 0.21), 0.72 + 0.08 * cos(uTime * 0.17))));
		leaf = mix(leaf, pale, glow * glow * 0.5);

		vec3 col = paper;
		col = mix(col, mix(paper, mid, 0.5), halo * 0.10 * uAlpha);   // soft shadow of the leaf on the paper
		col = mix(col, leaf, a * uAlpha);

		// The glass. Light comes from the left, so each strip is a touch lighter on its left side.
		col = mix(col, vec3(0.985, 0.975, 0.950), 0.2 * frost);     // the milky white of frosted glass
		float edge = min(u, 1. - u) * uStrip;                        // px to the nearest strip edge
		col *= 1. + 0.022 * -n * g;
		col += 0.05 * exp(-pow((u - 0.2) / 0.07, 2.)) * g;           // highlight along each strip
		col *= 1. - 0.07 * smoothstep(1.2, 0., edge) * g;            // hairline where two strips meet
		col *= 1. - 0.035 * smoothstep(0.55, 1., u) * g;             // the right side of a strip turns away from the light

		// Fade back to paper at the bottom.
		col = mix(col, paper, smoothstep(uSize.y - uFade, uSize.y, yTop));
		col += (hash(gl_FragCoord.xy + fract(uTime) * 61.) - 0.5) * 0.01;   // grain, also stops banding
		o = vec4(col, 1.);
	}`;

	const compile = (type, src) => {
		const s = gl.createShader(type); gl.shaderSource(s, src); gl.compileShader(s);
		if (!gl.getShaderParameter(s, gl.COMPILE_STATUS)) { console.warn('glass shader:', gl.getShaderInfoLog(s)); return null; }
		return s;
	};
	const program = (fs) => {
		const v = compile(gl.VERTEX_SHADER, VS), f = compile(gl.FRAGMENT_SHADER, fs);
		if (!v || !f) return null;
		const p = gl.createProgram(); gl.attachShader(p, v); gl.attachShader(p, f);
		gl.bindAttribLocation(p, 0, 'a'); gl.linkProgram(p);
		if (!gl.getProgramParameter(p, gl.LINK_STATUS)) { console.warn('glass link:', gl.getProgramInfoLog(p)); return null; }
		const u = {};
		for (let i = 0, n = gl.getProgramParameter(p, gl.ACTIVE_UNIFORMS); i < n; i++) { const name = gl.getActiveUniform(p, i).name; u[name] = gl.getUniformLocation(p, name); }
		return { p, u };
	};

	// One pass of a Gaussian blur along uDir: 25 taps spread over 3 sigma each side.
	const BLUR_FS = `#version 300 es
	precision highp float; precision highp sampler2DArray;
	uniform sampler2DArray uSrc; uniform float uLayer, uRes, uSigma; uniform vec2 uDir;
	out vec4 o;
	void main(){
		vec2 uv = gl_FragCoord.xy / uRes;
		float sum = 0., w = 0.;
		for (int i = -12; i <= 12; i++) {
			float x = float(i) * 0.25, k = exp(-0.5 * x * x);
			sum += texture(uSrc, vec3(uv + uDir * x * uSigma, uLayer)).r * k; w += k;
		}
		o = vec4(sum / w, 0., 0., 1.);
	}`;

	const main = program(FS), blurProg = program(BLUR_FS);
	if (!main || !blurProg) return;
	const prog = main.p, u = main.u;

	// One triangle that covers the screen.
	gl.bindBuffer(gl.ARRAY_BUFFER, gl.createBuffer());
	gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
	gl.enableVertexAttribArray(0); gl.vertexAttribPointer(0, 2, gl.FLOAT, false, 0, 0);

	// The leaf: the logo's coverage on a square, with room around it for the blur and halo.
	// Layer 0 holds the sharp leaf. Layer k holds it blurred with sigma LEVELS[k] (in texture widths).
	// Each layer is made from the one before by blurring across, into a scratch texture, then down.
	// Blurs add in squares, so each step adds sqrt(LEVELS[k]^2 - LEVELS[k-1]^2).
	const LEAF_FILL = 0.78, S = 1024;
	const LEVELS = [0, 0.0035, 0.007, 0.014, 0.028, 0.056];
	const array = (layers) => {
		const t = gl.createTexture(); gl.bindTexture(gl.TEXTURE_2D_ARRAY, t);
		gl.texStorage3D(gl.TEXTURE_2D_ARRAY, 1, gl.R8, S, S, layers);
		gl.texParameteri(gl.TEXTURE_2D_ARRAY, gl.TEXTURE_MIN_FILTER, gl.LINEAR); gl.texParameteri(gl.TEXTURE_2D_ARRAY, gl.TEXTURE_MAG_FILTER, gl.LINEAR);
		gl.texParameteri(gl.TEXTURE_2D_ARRAY, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE); gl.texParameteri(gl.TEXTURE_2D_ARRAY, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);
		return t;
	};
	const leafTex = array(LEVELS.length);
	let leafOn = false;
	const img = new Image();
	img.onload = () => {
		// Draw the leaf upside down, so the first row uploaded is the bottom, as WebGL expects.
		const c2 = document.createElement('canvas'); c2.width = c2.height = S;
		const ctx = c2.getContext('2d', { willReadFrequently: true });
		const k = LEAF_FILL * S / Math.max(img.width, img.height);
		ctx.translate(0, S); ctx.scale(1, -1);
		ctx.drawImage(img, (S - img.width * k) / 2, (S - img.height * k) / 2, img.width * k, img.height * k);
		const px = ctx.getImageData(0, 0, S, S).data, cover = new Uint8Array(S * S);
		for (let i = 0; i < cover.length; i++) cover[i] = px[i * 4 + 3];
		gl.bindTexture(gl.TEXTURE_2D_ARRAY, leafTex);
		gl.texSubImage3D(gl.TEXTURE_2D_ARRAY, 0, 0, 0, 0, S, S, 1, gl.RED, gl.UNSIGNED_BYTE, cover);

		const scratch = array(1), fb = gl.createFramebuffer();
		gl.bindFramebuffer(gl.FRAMEBUFFER, fb); gl.viewport(0, 0, S, S);
		gl.useProgram(blurProg.p);
		const bu = blurProg.u;
		gl.uniform1i(bu.uSrc, 0); gl.uniform1f(bu.uRes, S); gl.activeTexture(gl.TEXTURE0);
		const pass = (src, srcLayer, dst, dstLayer, dir, sigma) => {
			gl.framebufferTextureLayer(gl.FRAMEBUFFER, gl.COLOR_ATTACHMENT0, dst, 0, dstLayer);
			gl.bindTexture(gl.TEXTURE_2D_ARRAY, src);
			gl.uniform1f(bu.uLayer, srcLayer); gl.uniform2f(bu.uDir, dir[0], dir[1]); gl.uniform1f(bu.uSigma, sigma);
			gl.drawArrays(gl.TRIANGLES, 0, 3);
		};
		for (let i = 1; i < LEVELS.length; i++) {
			const add = Math.sqrt(LEVELS[i] ** 2 - LEVELS[i - 1] ** 2);
			pass(leafTex, i - 1, scratch, 0, [1, 0], add);
			pass(scratch, 0, leafTex, i, [0, 1], add);
		}
		gl.bindFramebuffer(gl.FRAMEBUFFER, null); gl.deleteFramebuffer(fb); gl.deleteTexture(scratch);
		leafOn = true;
		if (!running) render(performance.now());
	};
	img.src = cv.dataset.leaf;

	// Size the canvas to cover the nav and hero, plus a little of the next section.
	let W = 0, H = 0, heroTop = 0, heroH = 0;
	const resize = () => {
		const r = hero.getBoundingClientRect();
		const w = document.documentElement.clientWidth, h = Math.ceil(r.bottom + scrollY + EXTRA);
		heroTop = r.top + scrollY; heroH = r.height;
		const dpr = Math.min(Math.min(devicePixelRatio || 1, 1.5), Math.sqrt(MAX_PIXELS / (w * h)));
		const cw = Math.round(w * dpr), ch = Math.round(h * dpr);
		W = w; H = h; cv.style.height = H + 'px';
		if (cv.width !== cw || cv.height !== ch) { cv.width = cw; cv.height = ch; }
		if (!running) render(performance.now());
	};

	// Where the leaf sits. On wide screens it fills the right of the hero, beside the headline.
	// On phones the text runs the full width, so the leaf sits lower and shows more faintly.
	const place = () => {
		const narrow = W < 700;
		const size = narrow ? Math.min(W * 1.1, heroH * 0.8) : Math.min(heroH * 0.95, W * 0.48);
		const cx = narrow ? W * 0.62 : W * 0.76;
		const cyTop = narrow ? heroTop + heroH * 0.62 : heroTop + heroH * 0.52;
		return { x: cx, y: H - cyTop, size: size / LEAF_FILL, alpha: narrow ? 0.45 : 1 };
	};

	// The cursor pulls a lean point along on a damped spring, so the leaf follows it slowly and settles.
	let aim = [0, 0], lean = { x: 0, y: 0, vx: 0, vy: 0 };
	addEventListener('pointermove', (e) => {
		aim = [(e.clientX / innerWidth - 0.5) * 2, (e.clientY / innerHeight - 0.5) * 2];
	}, { passive: true });
	const leanStep = () => {
		lean.vx += (aim[0] - lean.x) * 0.02; lean.vy += (aim[1] - lean.y) * 0.02;
		lean.vx *= 0.86; lean.vy *= 0.86;
		lean.x += lean.vx; lean.y += lean.vy;
	};

	const t0 = performance.now();
	let running = false, raf = 0;
	const render = (now) => {
		const t = still ? 0 : (now - t0) / 1000;
		const P = place();
		const x = P.x + Math.sin(t * 0.23) * SWAY + lean.x * LEAN;
		const y = P.y + Math.sin(t * 0.17 + 1.3) * SWAY * 0.5 - lean.y * LEAN * 0.4;
		const ang = Math.sin(t * 0.13) * 0.05 + lean.x * 0.04;
		gl.bindFramebuffer(gl.FRAMEBUFFER, null); gl.viewport(0, 0, cv.width, cv.height);
		gl.useProgram(prog);
		gl.uniform2f(u.uSize, W, H); gl.uniform1f(u.uDpr, cv.width / W); gl.uniform1f(u.uTime, t);
		gl.uniform1f(u.uFade, FADE); gl.uniform1f(u.uStrip, W < 700 ? STRIP * 0.75 : STRIP);
		gl.uniform1f(u.uBend, BEND); gl.uniform1f(u.uSplit, SPLIT); gl.uniform1f(u.uFrost, FROST); gl.uniform1f(u.uFrostBlur, FROST_BLUR); gl.uniform1f(u.uHalo, HALO); gl.uniform2f(u.uBlur, BLUR[0], BLUR[1]);
		gl.uniform1f(u.uS1, LEVELS[1]); gl.uniform1f(u.uTop, LEVELS.length - 1); gl.uniform2f(u.uReveal, REVEAL[0] * W, REVEAL[1] * W);
		gl.uniform4f(u.uPlace, x, y, P.size, ang); gl.uniform1f(u.uAlpha, P.alpha);
		gl.uniform1f(u.uLeafOn, leafOn ? 1 : 0);
		gl.activeTexture(gl.TEXTURE0); gl.bindTexture(gl.TEXTURE_2D_ARRAY, leafTex); gl.uniform1i(u.uLeaf, 0);
		gl.drawArrays(gl.TRIANGLES, 0, 3);
	};
	const frame = (now) => {
		if (!running) return;
		raf = requestAnimationFrame(frame);
		leanStep();
		render(now);
	};

	// The glass runs only while it is the chosen background and the canvas is on screen.
	const chosen = () => document.documentElement.dataset.bg === 'glass';
	let onScreen = false, stopTimer = 0;
	const start = () => { if (running || still) return; running = true; raf = requestAnimationFrame(frame); };
	const stop = () => { running = false; cancelAnimationFrame(raf); };
	const apply = () => {
		const on = chosen();
		cv.classList.toggle('on', on);
		clearTimeout(stopTimer);
		if (on && onScreen) start();
		else if (!on) stopTimer = setTimeout(stop, 1500);   // keep moving while it fades out
	};

	resize();
	new ResizeObserver(resize).observe(hero);
	addEventListener('resize', resize);
	addEventListener('bgchange', apply);
	cv.addEventListener('webglcontextlost', () => { stop(); cv.classList.remove('on'); });
	new IntersectionObserver((es) => {
		onScreen = es[0].isIntersecting;
		if (!onScreen) stop(); else if (chosen()) start();
	}).observe(cv);
	apply();
});
</script>
