---
// A small switch, pinned to the bottom-left corner, that picks the hero background.
//
// The choice goes on <html data-bg="...">, and a `bgchange` event fires on window with the id.
// Each background effect (Water.astro, and any added later) watches for its own id and starts or stops.
// To add an effect, add it to `effects` and have its component listen for its id.
//
// The starting choice comes from ?bg=<id> in the URL, then from this viewer's last pick, then `fallback`.
interface Props {
	effects?: { id: string; label: string }[];
	fallback?: string;
}
const { effects = [{ id: 'water', label: 'Water' }, { id: 'off', label: 'Off' }], fallback = 'water' } = Astro.props;
const ids = effects.map((e) => e.id);
---
<div class="bg-toggle" role="group" aria-label="Hero background">
	<span>Background</span>
	{effects.map((e) => <button type="button" data-bg={e.id} aria-pressed="false">{e.label}</button>)}
</div>

<style>
	.bg-toggle{position:fixed;left:16px;bottom:16px;z-index:30;display:flex;align-items:center;gap:2px;padding:4px;border:1px solid var(--rule,rgba(18,36,28,.16));border-radius:999px;background:color-mix(in srgb,var(--paper,#F6F0E4) 88%,transparent);backdrop-filter:blur(10px);font:500 13px 'Inter Tight',system-ui,sans-serif;color:var(--muted,#5C6A61);box-shadow:0 2px 10px rgba(18,36,28,.06)}
	.bg-toggle span{padding:0 8px 0 10px}
	.bg-toggle button{font:inherit;color:inherit;background:none;border:0;border-radius:999px;padding:6px 12px;cursor:pointer;transition:background .2s,color .2s}
	.bg-toggle button:hover{color:var(--ink,#12241C)}
	.bg-toggle button[aria-pressed="true"]{background:var(--ink,#12241C);color:var(--paper,#F6F0E4)}
	.bg-toggle button:focus-visible{outline:2px solid var(--coral,#ED6A5A);outline-offset:2px}
</style>

<script is:inline define:vars={{ ids, fallback }}>
	(() => {
		const root = document.documentElement, KEY = 'elm-hero-bg';
		let pick = new URLSearchParams(location.search).get('bg');
		if (!ids.includes(pick)) { try { pick = localStorage.getItem(KEY); } catch {} }
		if (!ids.includes(pick)) pick = fallback;
		// Set the attribute now, before the effects start, so an "off" page never flashes the water.
		root.dataset.bg = pick;
		const set = (id, save) => {
			root.dataset.bg = id;
			document.querySelectorAll('.bg-toggle button').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.bg === id)));
			if (save) { try { localStorage.setItem(KEY, id); } catch {} }
			dispatchEvent(new CustomEvent('bgchange', { detail: id }));
		};
		addEventListener('DOMContentLoaded', () => {
			set(pick, false);
			document.querySelectorAll('.bg-toggle button').forEach((b) => b.addEventListener('click', () => set(b.dataset.bg, true)));
		});
	})();
</script>
