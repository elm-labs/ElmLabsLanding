---
import Contours from '../components/Contours.astro';
// Landing page. Paper-and-ink look with a coral accent. The hero is a dark
// green block over a slowly moving contour map (Contours.astro).
// The page is about getting one workflow into production;
// lower down, a chart of one workflow over 100 days with and without an evaluation, then a section on owning the intelligence.
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const mail = 'mailto:founders@elmlabs.ai?subject=20%20minutes';
const linkedin = { jawwad: 'https://www.linkedin.com/in/jawwadfarid/', burhan: 'https://www.linkedin.com/in/burhan-ashraf-60a064107/' };
const focus = [
	{ need: 'Proof and control', lead: "You're not live yet", why: ", because a decision with safety, regulatory or contractual weight has to be shown to be right.", rows: [
		['Energy and utilities', 'Triaging inspection and fault reports. Preparing regulatory returns from asset data.'],
		['Industrials', 'Checking supplier certificates and test records against the specification.'],
		['Construction', 'Assessing subcontractor claims and variations against the contract.'],
	] },
	{ need: 'Reliability at scale', lead: "You're already live.", why: " Quality has to hold as volume grows, and the bill has to be predictable. We start with the workflow you trust least.", rows: [
		['Fintech', 'Reviewing disputes and chargebacks. Checking onboarding documents.'],
		['Neobanks', 'Answering customer support at volume. Triaging transaction-monitoring alerts.'],
		['Gaming', 'Handling player support, account reviews and moderation.'],
	] },
];
---
<html lang="en">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
	<title>Elm Labs — AI you can trust in production</title>
	<meta name="description" content="Elm Labs engineers join your team, take one critical AI workflow into production, and keep it working as your data and processes change." />
	<meta name="theme-color" content="#0D2219" />
	<link rel="preconnect" href="https://fonts.googleapis.com" />
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
	<link href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
	<noscript><style>.rv{opacity:1!important;transform:none!important}.nav.top{background:color-mix(in srgb,var(--paper) 88%,transparent);border-bottom-color:var(--rule)}.nav.top .brand,.nav.top .btn{opacity:1;visibility:visible}</style></noscript>
</head>
<body style={`--logo:url(${base}logofilledwhite.svg)`}>
	<header class="nav top">
		<a class="brand" href="#top"><span class="leaf"></span>Elm Labs</a>
		<nav>
			<a href="#live">Getting to production</a>
			<a href="#monitor">Staying reliable</a>
			<a href="#focus">Use cases</a>
			<a href="#team">Team</a>
		</nav>
		<a class="btn sm" href={mail}>Book 20 minutes</a>
	</header>

	<main id="top">
		<section class="hero">
			<Contours />
			<p class="lockup" id="lockup"><span class="leaf"></span>Elm Labs</p>
			<h1>AI you can trust in production.</h1>
			<div class="hero-row">
				<div class="lede">
					<p>We've spent more than 10 years at Palantir getting customer workflows into production within&nbsp;weeks.</p>
					<p class="soft">AI workflows that learn from your experts' corrections, staying accurate as your data and models change.</p>
					<div class="cta">
						<a class="btn" href={mail}>Book 20 minutes <span>→</span></a>
					</div>
				</div>
			</div>
		</section>

		<section class="sec" id="live">
			<div class="live">
				<h2 class="rv">We take a workflow into production.</h2>
				<ol class="rv">
					<li><b>Inside your team</b><p>We learn from your experts by watching the work they already do and capturing the decisions they already make.</p></li>
					<li><b>Working with what you already use</b><p>Your models, your systems, your security rules. It complements the way you already work.</p></li>
					<li><b>Measured against your experts</b><p>The workflow learns from your experts' decisions and is tested against them. They review its work at first, and every correction makes it better.</p></li>
					<li class="hl"><b>Production ready in weeks</b><p>See the results on live work quickly, and have the evidence to put it into production with confidence.</p></li>
				</ol>
			</div>
		</section>

		<section class="sec" id="monitor">
			<div class="split">
				<h2 class="rv">We keep checking its work against your experts.</h2>
				<p class="sub rv">Formats change, processes evolve, and cases turn up that only an experienced operator would recognise. So we build tests from your experts' decisions alongside the workflow. When one of these changes breaks something, a test catches it and the workflow corrects itself.</p>
			</div>
			<div class="mon rv" id="mon" aria-label="Illustrative chart: the share of decisions that match your experts over 100 days, with and without an evaluation">
				<div class="mon-head"><span>Decisions that match your experts</span><span class="key"><i></i>With an evaluation<i class="k2"></i>Without</span></div>
				<canvas id="chart"></canvas>
				<ol class="events">
					<li data-d="23"><span>Day 23</span><b>A supplier changes its invoice template</b><p>Caught on the first invoice. The workflow adjusts to the new layout the same day.</p></li>
					<li data-d="58"><span>Day 58</span><b>A case nobody wrote down</b><p>The workflow sends it to one of your experts. Their answer becomes a new test.</p></li>
					<li data-d="81"><span>Day 81</span><b>The approval process changes</b><p>Tests on the old rule start to fail, and the workflow switches to the new one.</p></li>
				</ol>
			</div>
		</section>

		<section class="sec" id="focus">
			<h2 class="rv">Where this matters</h2>
			<div class="focus">
				{focus.map((f) => (
					<div class="rv">
						<h3>{f.need}</h3>
						<p class="why"><b>{f.lead}</b>{f.why}</p>
						<dl>{f.rows.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}</dl>
					</div>
				))}
			</div>
		</section>

		<section class="own" id="own">
			<div class="own-top">
				<h2 class="rv">We help you own the <em>intelligence</em> behind it.</h2>
				<p class="rv">Most companies rent their intelligence from a model vendor. Once a workflow is measured, you have a choice. We build you a model of your own, trained on how your experts decide, and the evaluation tells you when it is ready.</p>
			</div>
			<dl class="own-list rv">
				<div><dt>Your expertise, captured</dt><dd>Every decision and correction your experts make becomes a dataset that belongs to you.</dd></div>
				<div><dt>A model fitted to your work</dt><dd>We train a model on that dataset, so it is accurate on your workflows, not on everyone's.</dd></div>
				<div><dt>Running where you choose</dt><dd>Host it yourself. Your data stays inside your walls, cost is predictable at volume, and no vendor has a hold on you.</dd></div>
				<div><dt>Switched only when proven</dt><dd>A task moves to your model only once it matches what you run today, and the evaluation keeps checking that it does.</dd></div>
			</dl>
		</section>

		<section class="sec" id="team">
			<h2 class="rv">Who we are</h2>
			<div class="team">
				<div class="rv">
					<h3>Jawwad Farid</h3>
					<p>Palantir Developer Tech Lead, worked on the Ontology infrastructure. 2x AI startup Founding Engineer</p>
					<a href={linkedin.jawwad} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a>
				</div>
				<div class="rv">
					<h3>Burhan Ashraf</h3>
					<p>Six years at Palantir as a forward-deployed tech lead, leading one of its largest UK government accounts.</p>
					<a href={linkedin.burhan} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a>
				</div>
			</div>
		</section>

		<section class="close">
			<h2 class="rv">Book <em>20 minutes.</em></h2>
			<div class="rv">
				<p>Tell us about one workflow you wish you could trust. We'll tell you how we would get it there.</p>
				<a class="mail" href={mail}>founders@elmlabs.ai <span>→</span></a>
			</div>
		</section>
	</main>
	<footer class="foot"><span><span class="leaf"></span>Elm Labs</span><a href="https://www.linkedin.com/company/elm-labs-ai" target="_blank" rel="noopener noreferrer">LinkedIn</a><span>© 2026</span></footer>

	<style is:global>
		:root{--paper:#F6F0E4;--tint:#EFE7D6;--ink:#12241C;--green:#1F4D3A;--mid:#2E7A5E;--coral:#ED6A5A;--coral-d:#C4432B;--muted:#5C6A61;--rule:rgba(18,36,28,.16);--pad:clamp(18px,3vw,44px);--edge:max(clamp(20px,3.5vw,52px),calc((100vw - 1560px)/2))}
		*{box-sizing:border-box;margin:0;padding:0}
		html{scroll-behavior:smooth}
		body{background:var(--paper);color:var(--ink);font-family:'Inter Tight',system-ui,sans-serif;font-size:17.5px;line-height:1.5;-webkit-font-smoothing:antialiased}
		a{color:inherit;text-decoration:none}
		.leaf{display:inline-block;width:.82em;height:1em;vertical-align:-.12em;margin-right:.4em;background:currentColor;-webkit-mask:var(--logo) center/contain no-repeat;mask:var(--logo) center/contain no-repeat}
		h2 em,.lede em{font-style:normal;color:var(--mid)}
		.close h2 em{color:#D8C377}
		.rv{opacity:0;transform:translateY(22px);transition:opacity .9s cubic-bezier(.2,.7,.2,1),transform .9s cubic-bezier(.2,.7,.2,1)}
		.rv.in{opacity:1;transform:none}

		.nav{position:sticky;top:0;z-index:20;display:flex;align-items:center;justify-content:space-between;gap:24px;padding:14px var(--edge);background:color-mix(in srgb,var(--paper) 88%,transparent);backdrop-filter:blur(10px);border-bottom:1px solid var(--rule);transition:background .3s,border-color .3s}
		.brand{font-weight:600;font-size:21px;letter-spacing:-.02em;color:var(--green);transition:opacity .3s,visibility .3s}
		/* At the top of the page the hero lockup is the logo: the nav drops its own logo, line and background. */
		.nav.top{background:transparent;backdrop-filter:none;border-bottom-color:transparent}
		.nav .btn{transition:background .2s,opacity .3s,visibility .3s}
		.nav.top .brand,.nav.top .btn{opacity:0;visibility:hidden}
		.nav nav{display:flex;gap:28px;font-size:15px;color:var(--muted)}
		.nav nav a:hover{color:var(--ink)}
		.btn{display:inline-flex;align-items:center;gap:10px;background:var(--coral);color:#1B1210;padding:15px 22px;border-radius:3px;font-weight:600;font-size:16.5px;transition:background .2s}
		.btn:hover{background:#F58372}
		.btn span{transition:transform .2s}.btn:hover span{transform:translateX(4px)}
		.btn.sm{padding:9px 15px;font-size:14.5px}

		/* The hero is a dark green block with light text. The contour map (Contours.astro) is drawn inside it,
		   behind the text, and reaches up under the nav. The gradient shows until it draws, or if WebGL2 is missing. */
		.hero{position:relative;isolation:isolate;padding:clamp(4px,1.2vw,20px) var(--edge) clamp(64px,8vw,128px);background:linear-gradient(110deg,#112C21 30%,#678459);color:var(--paper)}
		.hero .lockup{color:var(--paper)}
		.hero .lede .soft{color:rgba(246,240,228,.8)}
		.hero h1{text-shadow:0 .02em .12em rgba(10,26,18,.25)}
		.nav.top nav{color:rgba(246,240,228,.82)}
		.nav.top nav a:hover{color:var(--paper)}
		h1{font-size:clamp(3.2rem,min(11.4vw,16.5vh),12rem);font-weight:600;line-height:.88;letter-spacing:-.055em;margin-left:-.05em;max-width:12ch}
		.hero-row{margin-top:clamp(24px,3vw,44px)}
		.lede p{font-size:clamp(20px,1.9vw,27px);line-height:1.25;letter-spacing:-.02em;max-width:30ch;font-weight:500}
		/* Wide enough that the first paragraph sits on two lines on desktop. */
		.lede p:first-child{max-width:37ch}
		.lede .soft{font-size:clamp(17px,1.35vw,20px);font-weight:400;letter-spacing:-.005em;line-height:1.45;color:var(--muted);max-width:40ch;margin-top:16px}
		.cta{display:flex;align-items:center;gap:18px;flex-wrap:wrap;margin-top:30px}
		.lockup{font-size:clamp(2.6rem,5vw,4.75rem);font-weight:600;line-height:1;letter-spacing:-.045em;color:var(--green);margin-bottom:clamp(36px,4.2vw,64px)}
		.lockup .leaf{margin-right:.28em}

		.sec{padding:clamp(64px,8.5vw,140px) var(--edge) 0}
		h2{font-size:clamp(2rem,4.6vw,4.6rem);font-weight:600;line-height:1;letter-spacing:-.045em;max-width:18ch;margin-bottom:clamp(30px,4vw,60px)}
		h3{font-size:clamp(1.5rem,2.5vw,2.4rem);font-weight:600;letter-spacing:-.035em;line-height:1.05}

		.live{display:grid;grid-template-columns:.85fr 1.15fr;gap:clamp(24px,3vw,48px);align-items:start}
		.live h2{margin:0;max-width:13ch}
		.live ol{list-style:none;border-top:1px solid var(--ink)}
		.live li{display:grid;grid-template-columns:1fr 1.25fr;gap:var(--pad);padding:20px 0;border-bottom:1px solid var(--rule)}
		.live b{color:var(--green);font-size:clamp(19px,1.6vw,23px);font-weight:600;letter-spacing:-.02em;line-height:1.2}
		.live p{color:var(--muted)}
		.live .hl{background:var(--green);color:var(--paper);padding:22px 20px;margin:0 -20px;border-bottom:0}
		.live .hl b{color:inherit}
		.live .hl p{color:inherit;opacity:.85}

		.split{display:grid;grid-template-columns:1.4fr 1fr;gap:var(--pad);align-items:end;margin-bottom:clamp(30px,4vw,60px)}
		.split h2{margin:0}
		.sub{font-size:clamp(17px,1.4vw,20px);color:var(--muted);max-width:38ch}
		.mon{background:#FFFDF8;border:1px solid var(--ink)}
		.mon-head{display:flex;justify-content:space-between;gap:10px 16px;flex-wrap:wrap;padding:16px 22px;border-bottom:1px solid var(--rule);font-size:15.5px;font-weight:500}
		.key{color:var(--muted);font-weight:400}
		.key i{display:inline-block;width:18px;height:3px;background:var(--green);vertical-align:middle;margin-right:8px}
		.key i.k2{background:var(--coral-d);margin-left:18px}
		.mon canvas{display:block;width:100%;height:clamp(240px,26vw,340px)}
		.events{list-style:none;display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid var(--ink)}
		.events li{padding:18px 22px 22px;border-right:1px solid var(--rule);opacity:.35;transition:opacity .5s}
		.events li:last-child{border-right:0}
		.events li.lit{opacity:1}
		.events span{display:block;font:500 12.5px 'JetBrains Mono',ui-monospace,monospace;color:var(--coral-d);margin-bottom:6px}
		.events b{display:block;font-size:17.5px;font-weight:600;letter-spacing:-.015em;line-height:1.25;margin-bottom:4px}
		.events p{color:var(--muted);font-size:15.5px}
		.cap{margin-top:16px;font-size:15.5px;color:var(--muted);max-width:76ch}

		.focus{display:grid;grid-template-columns:1fr 1fr}
		.focus>div{padding:clamp(22px,2.8vw,42px)}
		.focus>div:nth-child(1){background:var(--green);color:var(--paper)}
		.focus>div:nth-child(2){background:#CFD8B8}
		.focus h3{font-size:clamp(2rem,3.8vw,3.8rem);letter-spacing:-.045em;line-height:1}
		.why{font-size:clamp(17px,1.4vw,20px);max-width:36ch;opacity:.86;margin:14px 0 clamp(28px,3.4vw,52px)}
		.focus dl div{display:grid;grid-template-columns:minmax(120px,.7fr) 2fr;gap:18px;padding:14px 0;border-top:1px solid currentColor;font-size:16.5px}
		.focus dt{font-weight:600}
		.focus dd{opacity:.86}
		.own{margin-top:clamp(64px,8.5vw,140px);padding:clamp(48px,6vw,96px) var(--edge);background:var(--tint);border-top:1px solid var(--ink);border-bottom:1px solid var(--ink)}
		.own-top{display:grid;grid-template-columns:1.4fr 1fr;gap:var(--pad);align-items:end;margin-bottom:clamp(32px,4vw,60px)}
		.own h2{margin:0;max-width:15ch}
		.own-top p{color:var(--muted);max-width:44ch;font-size:clamp(17px,1.4vw,20px)}
		.own-list{display:grid;grid-template-columns:repeat(4,1fr);gap:var(--pad)}
		.own-list div{border-top:1px solid var(--ink);padding-top:16px}
		.own-list dt{font-size:clamp(18px,1.5vw,21px);font-weight:600;letter-spacing:-.02em;line-height:1.2;color:var(--green);margin-bottom:8px}
		.own-list dd{color:var(--muted);font-size:16px}

		.team{display:grid;grid-template-columns:1fr 1fr;gap:var(--pad)}
		.team>div{border-top:1px solid var(--ink);padding-top:18px}
		.team h3{margin-bottom:10px}
		.team p{color:var(--muted);max-width:40ch}
		.team a{display:inline-block;margin-top:16px;font-weight:600;font-size:16px;color:var(--green);border-bottom:1.5px solid currentColor}
		.team a:hover{color:var(--coral-d)}

		.close{display:grid;grid-template-columns:1.4fr 1fr;gap:var(--pad);align-items:end;margin-top:clamp(80px,10vw,160px);padding:clamp(56px,8vw,130px) var(--edge);background:var(--green);color:var(--paper)}
		.close h2{font-size:clamp(3rem,9vw,9.4rem);line-height:.88;letter-spacing:-.055em;max-width:8ch;margin:0}
		.close p{font-size:clamp(18px,1.5vw,22px);max-width:34ch;margin-bottom:26px;opacity:.9}
		.mail{font-size:clamp(1.3rem,2.4vw,2.2rem);font-weight:500;letter-spacing:-.03em;color:var(--coral);border-bottom:2px solid currentColor;padding-bottom:3px}
		.mail span{display:inline-block;transition:transform .25s}.mail:hover span{transform:translateX(8px)}
		.foot{display:flex;justify-content:space-between;padding:20px var(--edge);font-size:15px;background:var(--green);color:rgba(246,240,228,.75);border-top:1px solid rgba(246,240,228,.2)}

		@media (max-width:900px){
			.nav nav{display:none}
			.live,.split,.focus,.own-top,.team,.close,.events{grid-template-columns:minmax(0,1fr)}
			.own-list{grid-template-columns:1fr 1fr}
			.events li{border-right:0;border-bottom:1px solid var(--rule)}.events li:last-child{border-bottom:0}
			.team{gap:36px}
		}
		@media (max-width:520px){.own-list{grid-template-columns:1fr}.live li,.focus dl div{grid-template-columns:1fr;gap:4px}}
		@media (prefers-reduced-motion:reduce){.rv{opacity:1;transform:none;transition:none}html{scroll-behavior:auto}}
	</style>

	<script is:inline>
		const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }), { threshold: 0.12 });
		document.querySelectorAll('.rv').forEach((el, i) => { el.style.transitionDelay = (i % 3) * 80 + 'ms'; io.observe(el); });

		// While the hero lockup is on screen the nav has no logo, line or background, so the logo never shows twice.
		(() => {
			const nav = document.querySelector('.nav'), lockup = document.getElementById('lockup');
			new IntersectionObserver((es) => nav.classList.toggle('top', es[0].isIntersecting), { rootMargin: '-64px 0px 0px 0px' }).observe(lockup);
		})();

		// Day-100 chart: the share of decisions that match the experts, with and without an evaluation,
		// across three changes. It draws itself while on screen, holds, then repeats. Illustrative.
		(() => {
			const cv = document.getElementById('chart'), mon = document.getElementById('mon'), evs = [...mon.querySelectorAll('.events li')];
			const still = matchMedia('(prefers-reduced-motion:reduce)').matches;
			const E = [[23, 6, 7], [58, 4, 5], [81, 7, 9]]; // day, short dip with an evaluation, lasting loss without
			const sm = (x) => (x <= 0 ? 0 : x >= 1 ? 1 : x * x * (3 - 2 * x));
			const wob = (d, k) => Math.sin(d * 0.9 + k) * 0.35 + Math.sin(d * 2.3 + k * 2) * 0.25;
			const withE = (d) => 95 + d * 0.015 + wob(d, 1) - E.reduce((a, [t, dip]) => a + dip * sm((d - t) / 1.5) * (1 - sm((d - t - 2) / 4)), 0);
			const noE = (d) => 95 + wob(d, 4) - E.reduce((a, [t, , loss]) => a + loss * sm((d - t) / 3), 0);
			const LO = 64, HI = 100; let start = null, vis = false;
			const draw = (now) => {
				if (start === null) start = now;
				const el = (now - start) / 1000, day = still ? 100 : Math.min(100, 1 + el * 9);
				if (el > 16.5) start = now;
				const dpr = Math.min(2, devicePixelRatio || 1), w = cv.clientWidth, h = cv.clientHeight;
				if (cv.width !== Math.round(w * dpr)) { cv.width = Math.round(w * dpr); cv.height = Math.round(h * dpr); }
				const g = cv.getContext('2d'); g.setTransform(dpr, 0, 0, dpr, 0, 0); g.clearRect(0, 0, w, h);
				const L = 52, R = 58, T = 18, B = 30, X = (d) => L + ((d - 1) / 99) * (w - L - R), Y = (v) => T + (1 - (v - LO) / (HI - LO)) * (h - T - B);
				g.font = "12px 'JetBrains Mono', ui-monospace, monospace"; g.fillStyle = '#5C6A61'; g.lineWidth = 1;
				g.textAlign = 'right'; g.textBaseline = 'middle';
				[70, 80, 90, 100].forEach((v) => { g.strokeStyle = 'rgba(18,36,28,.1)'; g.beginPath(); g.moveTo(L, Y(v)); g.lineTo(w - R, Y(v)); g.stroke(); g.fillText(v + '%', L - 10, Y(v)); });
				g.textBaseline = 'alphabetic';
				[1, 25, 50, 75, 100].forEach((d) => { g.textAlign = d === 1 ? 'left' : d === 100 ? 'right' : 'center'; g.fillText('Day ' + d, X(d), h - 8); });
				E.forEach(([t]) => { if (day < t) return; g.strokeStyle = 'rgba(18,36,28,.45)'; g.setLineDash([3, 4]); g.beginPath(); g.moveTo(X(t), T); g.lineTo(X(t), h - B); g.stroke(); g.setLineDash([]); });
				const line = (f, col, lw, label) => {
					g.beginPath(); g.moveTo(X(1), Y(f(1)));
					for (let d = 1.25; d < day; d += 0.25) g.lineTo(X(d), Y(f(d)));
					g.lineTo(X(day), Y(f(day))); g.strokeStyle = col; g.lineWidth = lw; g.lineJoin = 'round'; g.stroke();
					g.beginPath(); g.arc(X(day), Y(f(day)), 4, 0, 7); g.fillStyle = col; g.fill();
					if (label) { g.font = "600 14px 'Inter Tight', system-ui, sans-serif"; g.textAlign = 'left'; g.textBaseline = 'middle'; g.fillText(Math.round(f(day)) + '%', X(day) + 10, Y(f(day))); }
				};
				line(noE, '#C4432B', 2, withE(day) - noE(day) > 3.5); line(withE, '#1F4D3A', 2.5, true);
				evs.forEach((li) => li.classList.toggle('lit', day >= +li.dataset.d));
				if (!still && vis) requestAnimationFrame(draw);
			};
			if (still) { requestAnimationFrame(draw); addEventListener('resize', () => requestAnimationFrame(draw)); return; }
			new IntersectionObserver((es) => {
				const v = es[0].isIntersecting;
				if (v && !vis) { vis = true; start = null; requestAnimationFrame(draw); } else if (!v) vis = false;
			}, { threshold: 0.25 }).observe(mon);
		})();
	</script>
</body>
</html>
