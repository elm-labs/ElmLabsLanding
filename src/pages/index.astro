---
import '../styles/global.css';
import PixelGrid from '../components/PixelGrid.astro';

// Get the base URL for assets
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>ElmLabs - Agentic AI for Enterprise</title>
		
		<!-- Theme color for browser UI (dark theme) -->
		<meta name="theme-color" content="#000000" />
		<meta name="color-scheme" content="dark" />
		
		<!-- Inter (body + UI) -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
		
		<style>
			body {
				font-family: 'Inter', system-ui, sans-serif;
			}
		</style>
	</head>
	<body class="overflow-hidden">
		<div class="pointer-events-none fixed inset-0 z-0 overflow-hidden" aria-hidden="true">
			<img
				src={`${base}background.jpg`}
				alt=""
				class="h-full w-full object-cover object-center"
				fetchpriority="high"
			/>
		</div>

		<!-- Shimmering pixel grid over the photo -->
		<PixelGrid />

	<!-- Logo + heading: stacked, left, vertically centered as a group (matches slide) -->
	<div class="relative z-10 flex min-h-screen flex-col justify-center pl-10 pr-6 md:pl-32 md:pr-20 -translate-y-8 md:-translate-y-12">
		<div class="hero-stack flex flex-col items-start gap-5 md:gap-6">
			<img
				src={`${base}logo_FAF3E9.png`}
				alt="Elm Labs Logo"
				class="hero-logo"
			/>
			<h1 class="hero-title text-[#FAF3E9] font-semibold leading-[0.95] tracking-[-0.025em]">
				Elm Labs
			</h1>
		</div>
	</div>

	<!-- Email + LinkedIn: bottom-right, dark green -->
	<div class="fixed bottom-6 right-6 z-10 flex items-center gap-3 md:bottom-12 md:right-12 md:gap-4 text-[0.8125rem] md:text-sm">
		<a
			href="mailto:founders@elmlabs.ai"
			class="text-[#143d32] hover:text-[#0f2e26] transition-colors duration-200 tracking-wide"
		>
			founders@elmlabs.ai
		</a>
		<a
			href="https://www.linkedin.com/company/elm-labs-ai"
			target="_blank"
			rel="noopener noreferrer"
			class="text-[#143d32] hover:text-[#0f2e26] transition-colors duration-200 shrink-0"
			aria-label="Elm Labs on LinkedIn"
		>
			<svg class="block h-[1.25em] w-[1.25em]" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
				<path
					d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
				/>
			</svg>
		</a>
	</div>


		<style>
			/* Smooth font rendering */
			body {
				-webkit-font-smoothing: antialiased;
				-moz-osx-font-smoothing: grayscale;
			}
			
			.hero-stack {
				/* 25% larger than previous clamp(4.2rem, 11vw, 8.6rem) */
				--hero-text-size: clamp(5.25rem, 13.75vw, 10.75rem);
			}
			.hero-logo {
				display: block;
				height: var(--hero-text-size);
				width: auto;
				max-width: 100%;
				object-fit: contain;
				object-position: left center;
			}
			.hero-title {
				margin: 0;
				padding: 0;
				font-size: var(--hero-text-size);
				/* Offset font side-bearing so “E” lines up with logo’s left edge */
				margin-left: -0.07em;
				text-shadow: 0 0.03em 0.06em rgba(0, 0, 0, 0.12);
			}
		</style>
	</body>
</html>