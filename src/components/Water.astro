---
// Water seen from above, drawn behind the hero with WebGL2.
//
// Two parts, both on the GPU:
// 1. A ripple simulation. A small texture (one texel per CELL css px) holds water height and velocity.
//    Each step averages a texel's four neighbours (the wave equation), and the cursor pushes the
//    surface down along the path it moved. Two textures take turns as source and target.
// 2. Caustics. The surface is a sum of slow sine waves plus the ripple heights. Light refracts through
//    it onto a flat floor. Where the surface curvature focuses light the floor is brighter, where it
//    spreads light the floor is darker. Brightness is 1 / det(J), where J is the Jacobian of the map
//    from surface point to floor point (Evan Wallace's area-ratio method, done per pixel).
// 3. Leaves. A few Elm Labs leaves float on the surface and cast soft shadows on the floor. They move
//    on the CPU: a slow current carries them, ripple slopes push them, and the cursor's wake shoves
//    and spins them. Each frame asks the GPU for the ripple heights under each leaf and picks the
//    answer up a frame or two later, so reading it back never stalls the page.
//
// It runs only while <html data-bg> is "water" or unset (see BgToggle.astro) and the canvas is on screen.
// Without WebGL2 the canvas stays hidden and the hero keeps the plain paper background.
// Without renderable half-float textures there are caustics but no cursor ripples.
interface Props { target?: string }
const { target = '.hero' } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---
<canvas class="water" id="water" data-target={target} data-leaf={`${base}logofilledwhite.svg`} aria-hidden="true"></canvas>

<style>
	.water{position:absolute;top:0;left:0;width:100%;height:0;z-index:-1;pointer-events:none;opacity:0;transition:opacity 1.4s ease}
	.water.on{opacity:1}
</style>

<script is:inline>
// The canvas sits above the hero in the markup, so wait for the rest of the page before looking it up.
addEventListener('DOMContentLoaded', () => {
	const cv = document.getElementById('water');
	const hero = document.querySelector(cv.dataset.target);
	const gl = cv.getContext('webgl2', { alpha: false, antialias: false, depth: false, stencil: false, preserveDrawingBuffer: false });
	if (!gl || !hero) return;

	// Tuning. Lengths are css px.
	const CELL = 4;          // ripple simulation texel size
	const EXTRA = 110;       // how far the water runs past the bottom of the hero
	const FADE = 260;        // length of the fade back to paper at the bottom
	const FOCUS = 0.8;       // strength of the ambient caustics (higher = more bright lines)
	const RIPPLE = 1;        // how strongly cursor ripples bend the light
	const SPEED = 0.55;      // speed of the ambient waves
	const SHADE = 0.7;       // depth of the soft shadows
	const SHINE = 0.7;       // brightness of the light lines
	const DAMP = 0.987;      // ripple velocity kept per step; lower dies out faster
	const WAVE = 1.1;        // ripple travel speed; the stable maximum is 2
	const PULL = 0.025;      // how hard the wake point is pulled toward the cursor each step
	const DRAG = 0.82;       // wake point velocity kept per step; lower is heavier and less springy
	const LEAF_SIZE = [26, 40];   // leaf height range
	const CURRENT = [6, 0];       // the slow current that carries the leaves, px per second (y up)
	const SLOPE = 5;              // how hard ripple slopes push the leaves
	const LIFT = 1.5;             // how much a leaf grows on a crest and shrinks in a trough
	const RAYS = 1.5;             // strength of the golden sun rays from the top left
	const TINT = 0.8;             // strength of the green tint from the top
	const MAX_PIXELS = 3.5e6;     // render-resolution budget; larger canvases render at a lower pixel ratio
	const SLOW_GAP = 22;          // ms between renders, on average, that counts as the machine falling behind
	const still = matchMedia('(prefers-reduced-motion: reduce)').matches;

	const VS = `#version 300 es
	in vec2 a; void main(){ gl_Position = vec4(a, 0., 1.); }`;

	const SIM = `#version 300 es
	precision highp float;
	uniform sampler2D uState; uniform vec2 uTexel; uniform vec4 uSeg; uniform vec2 uDrop; uniform float uDamp, uWave;
	out vec4 o;
	void main(){
		vec2 uv = gl_FragCoord.xy * uTexel;
		vec4 s = texture(uState, uv);
		float avg = 0.25 * (texture(uState, uv + vec2(uTexel.x, 0.)).r + texture(uState, uv - vec2(uTexel.x, 0.)).r
			+ texture(uState, uv + vec2(0., uTexel.y)).r + texture(uState, uv - vec2(0., uTexel.y)).r);
		s.g += (avg - s.r) * uWave;
		s.g *= uDamp;
		s.r += s.g;
		s.r *= 0.998;
		if (uDrop.y != 0.) {
			vec2 p = gl_FragCoord.xy, a = uSeg.xy, ab = uSeg.zw - uSeg.xy;
			float t = clamp(dot(p - a, ab) / max(dot(ab, ab), 1e-4), 0., 1.);
			float f = max(0., 1. - length(p - a - ab * t) / uDrop.x);
			s.r -= uDrop.y * (0.5 - 0.5 * cos(f * 3.14159265));
		}
		o = s;
	}`;

	const FS = `#version 300 es
	precision highp float;
	uniform vec2 uSize; uniform float uDpr, uTime, uFade, uFocus, uRipple, uSpeed, uCell, uSimOn, uShade, uShine;
	uniform sampler2D uSim; uniform vec2 uSimSize;
	uniform sampler2D uLeafTex; uniform vec4 uLeaf[8], uLeafB[8]; uniform int uLeafN; uniform float uLeafOn, uTint, uRays;
	out vec4 o;

	float hash(vec2 p){ p = fract(p * vec2(123.34, 456.21)); p += dot(p, p + 45.32); return fract(p.x * p.y); }
	float vnoise(vec2 p){
		vec2 i = floor(p), f = fract(p); f = f * f * (3. - 2. * f);
		return mix(mix(hash(i), hash(i + vec2(1, 0)), f.x), mix(hash(i + vec2(0, 1)), hash(i + vec2(1, 1)), f.x), f.y);
	}
	float sim(vec2 uv){ return texture(uSim, uv).r; }
	// 1 inside a leaf quad, falling to 0 at its edge, so blurred texels never show the square.
	float inQuad(vec2 u){ return smoothstep(0., 0.1, min(min(u.x, u.y), min(1. - u.x, 1. - u.y))); }

	const int N = 13;
	void main(){
		vec2 p = gl_FragCoord.xy / uDpr;            // css px, origin bottom-left
		float yTop = uSize.y - p.y;
		float t = uTime;

		// Ambient waves. For h = a sin(th): displacement = (f/k) cos(th) d, Jacobian -= f sin(th) d d^T,
		// where f = depth * a * k^2 is how hard the wave focuses light.
		vec2 disp = vec2(0.);
		mat2 J = mat2(1.);
		float f = uFocus * 0.42;
		for (int i = 0; i < N; i++) {
			float fi = float(i);
			float ang = 0.6 + (fract(fi * 0.618034 + 0.11) - 0.5) * 2.9;
			vec2 d = vec2(cos(ang), sin(ang));
			float lam = mix(85., 240., fract(fi * 0.7548777 + 0.29));
			float k = 6.2831853 / lam;
			float w = sqrt(50. * k) * uSpeed;
			float th = k * dot(d, p) - w * t + fract(sin(fi * 91.7) * 4375.3) * 6.2831853;
			float s = sin(th), c = cos(th);
			disp += (f / k) * c * d;
			J -= f * s * mat2(d.x * d.x, d.x * d.y, d.x * d.y, d.y * d.y);
		}

		// Cursor ripples: gradient and curvature of the simulated height.
		float rg = 0.;
		if (uSimOn > 0.5) {
			vec2 uv = p / (uSimSize * uCell), e = 1.25 / uSimSize;
			float hc = sim(uv);
			float hl = sim(uv - vec2(e.x, 0.)), hr = sim(uv + vec2(e.x, 0.));
			float hd = sim(uv - vec2(0., e.y)), hu = sim(uv + vec2(0., e.y));
			float hru = sim(uv + e), hld = sim(uv - e), hrd = sim(uv + vec2(e.x, -e.y)), hlu = sim(uv + vec2(-e.x, e.y));
			float st = 1.25 * uCell;
			vec2 g = vec2(hr - hl, hu - hd) / (2. * st);
			float hxx = (hr - 2. * hc + hl) / (st * st), hyy = (hu - 2. * hc + hd) / (st * st);
			float hxy = (hru - hrd - hlu + hld) / (4. * st * st);
			disp += uRipple * 500. * g;
			J += uRipple * 500. * mat2(hxx, hxy, hxy, hyy);
			rg = dot(g, normalize(vec2(-0.55, 0.85)));
		}

		// Light on the floor, per channel so the brightest lines split slightly into colour.
		// I is 1 where the surface is flat, above 1 where it focuses light, below 1 where it spreads it.
		mat2 D = J - mat2(1.);
		vec3 I;
		I.r = 1. / max(abs(determinant(mat2(1.) + D * 0.97)), 0.03);
		I.g = 1. / max(abs(determinant(J)), 0.03);
		I.b = 1. / max(abs(determinant(mat2(1.) + D * 1.03)), 0.03);
		vec3 hi = max(I - 1., 0.); hi = hi / (1. + hi * 0.35);   // bright lines, peaks softened
		float sh = clamp(1. - I.g, 0., 1.);                        // where light is spread thin

		// The floor: pale sand with soft patches, seen through the moving surface.
		vec2 q = p + disp;
		float m = vnoise(q / 380.) * 0.7 + vnoise(q / 140. + 7.3) * 0.3;
		vec3 paper = vec3(0.965, 0.941, 0.894);
		vec3 bed = mix(vec3(0.935, 0.925, 0.870), vec3(0.900, 0.910, 0.860), m);
		vec3 col = bed - vec3(0.075, 0.055, 0.050) * sh * uShade;       // shadows lean sage, not grey
		col += vec3(0.060, 0.058, 0.050) * hi * uShine;                  // light lines lean warm white
		col += vec3(0.9, 0.95, 0.9) * rg * uRipple * 6.;              // light catching the ripple crests

		// A faint forest green that is strongest at the top and gone by three quarters of the way down,
		// as if trees overhang the far edge of the pool. Multiplied, so the light pattern stays visible.
		col *= mix(vec3(1.), vec3(0.93, 0.975, 0.925), uTint * (1. - smoothstep(0., uSize.y * 0.75, yTop)));

		// Sun rays through the water: soft parallel shafts running diagonally from top left to bottom right.
		// Noise across the shafts sets where they are; a second, finer layer that also varies along their
		// length makes them shimmer. They fade as they travel away from the top-left corner.
		{
			vec2 dir = normalize(vec2(1., -1.15));             // the way the light travels (y is up)
			vec2 rel = p - vec2(0., uSize.y);                    // from the top-left corner
			float across = dot(rel, vec2(-dir.y, dir.x)), along = dot(rel, dir);
			// Thresholding the noise gives separate shafts with soft edges instead of one even wash.
			float wide = smoothstep(0.45, 0.9, vnoise(vec2(across / 150., t * 0.12)));
			float soft = smoothstep(0.5, 0.95, vnoise(vec2(across / 80. + 11., t * 0.25 - along * 0.001)));
			float shaft = wide * 0.85 + soft * 0.3;              // 0 between shafts, about 1 in the brightest
			float ray = shaft * exp(-max(along, 0.) / (0.8 * max(uSize.x, 900.))) * uRays;
			col *= 1. - 0.035 * (1. - min(shaft * 1.5, 1.)) * uRays;        // gaps between shafts a touch darker
			col = col * mix(vec3(1.), vec3(1.03, 1.0, 0.92), clamp(ray * 1.2, 0., 1.)) + vec3(0.92, 0.82, 0.60) * ray * 0.11;
		}

		// Leaves on the surface, each with a soft shadow on the floor below and to the right.
		// uLeaf: centre (css px, y up), angle, quad size. uLeafB: tint, opacity, lift.
		if (uLeafOn > 0.5) {
			float shadow = 0.;
			vec4 leaf = vec4(0.);
			for (int i = 0; i < 8; i++) {
				if (i >= uLeafN) break;
				vec4 L = uLeaf[i], M = uLeafB[i];
				mat2 R = mat2(cos(L.z), -sin(L.z), sin(L.z), cos(L.z));   // turns by -angle
				vec2 us = R * (p - L.xy - vec2(9., -12.) * M.z) / L.w + 0.5;
				if (all(greaterThan(us, vec2(0.))) && all(lessThan(us, vec2(1.)))) {
					// Five taps of a low-resolution copy of the leaf make a wide, soft blur.
					const float o = 0.04;
					float sa = textureLod(uLeafTex, us, 3.).a + textureLod(uLeafTex, us + vec2(o, 0.), 3.).a + textureLod(uLeafTex, us - vec2(o, 0.), 3.).a
						+ textureLod(uLeafTex, us + vec2(0., o), 3.).a + textureLod(uLeafTex, us - vec2(0., o), 3.).a;
					shadow = max(shadow, sa * 0.2 * M.y * inQuad(us));
				}
				vec2 ul = R * (p - L.xy) / L.w + 0.5;
				if (all(greaterThan(ul, vec2(0.))) && all(lessThan(ul, vec2(1.)))) {
					float a = texture(uLeafTex, ul).a * M.y * inQuad(ul);
					if (a > leaf.a) {
						vec3 dark = mix(vec3(0.36, 0.56, 0.45), vec3(0.55, 0.62, 0.40), M.x);
						vec3 lite = mix(vec3(0.55, 0.72, 0.59), vec3(0.72, 0.77, 0.54), M.x);
						leaf = vec4(mix(dark, lite, smoothstep(0.15, 0.85, ul.y * 0.65 + ul.x * 0.35)), a);
					}
				}
			}
			col *= 1. - 0.13 * shadow;
			col = mix(col, leaf.rgb, leaf.a);
		}

		// Fade back to paper at the bottom.
		float fade = smoothstep(uSize.y - uFade, uSize.y, yTop);
		col = mix(col, paper, fade);
		col += (hash(gl_FragCoord.xy + fract(t) * 61.) - 0.5) * 0.012;  // grain, also stops banding
		o = vec4(col, 1.);
	}`;

	const compile = (type, src) => {
		const s = gl.createShader(type); gl.shaderSource(s, src); gl.compileShader(s);
		if (!gl.getShaderParameter(s, gl.COMPILE_STATUS)) { console.warn('water shader:', gl.getShaderInfoLog(s)); return null; }
		return s;
	};
	const program = (fs) => {
		const v = compile(gl.VERTEX_SHADER, VS), f = compile(gl.FRAGMENT_SHADER, fs);
		if (!v || !f) return null;
		const p = gl.createProgram(); gl.attachShader(p, v); gl.attachShader(p, f);
		gl.bindAttribLocation(p, 0, 'a'); gl.linkProgram(p);
		if (!gl.getProgramParameter(p, gl.LINK_STATUS)) { console.warn('water link:', gl.getProgramInfoLog(p)); return null; }
		const u = {}; const n = gl.getProgramParameter(p, gl.ACTIVE_UNIFORMS);
		for (let i = 0; i < n; i++) { const name = gl.getActiveUniform(p, i).name; u[name] = gl.getUniformLocation(p, name); }
		return { p, u };
	};
	const draw = program(FS), step = program(SIM);
	if (!draw) return;

	// One triangle that covers the screen.
	gl.bindBuffer(gl.ARRAY_BUFFER, gl.createBuffer());
	gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
	gl.enableVertexAttribArray(0); gl.vertexAttribPointer(0, 2, gl.FLOAT, false, 0, 0);

	// Ripple simulation needs float textures we can render into.
	let simOn = !still && !!step && !!(gl.getExtension('EXT_color_buffer_float') || gl.getExtension('EXT_color_buffer_half_float'));
	let tex = [], fbo = [], cur = 0, sw = 0, sh = 0;
	const makeSim = () => {
		tex.forEach((t) => gl.deleteTexture(t)); fbo.forEach((f) => gl.deleteFramebuffer(f)); tex = []; fbo = [];
		for (let i = 0; i < 2; i++) {
			const t = gl.createTexture(); gl.bindTexture(gl.TEXTURE_2D, t);
			gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA16F, sw, sh, 0, gl.RGBA, gl.HALF_FLOAT, null);
			gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR); gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, gl.LINEAR);
			gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE); gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);
			const f = gl.createFramebuffer(); gl.bindFramebuffer(gl.FRAMEBUFFER, f);
			gl.framebufferTexture2D(gl.FRAMEBUFFER, gl.COLOR_ATTACHMENT0, gl.TEXTURE_2D, t, 0);
			if (gl.checkFramebufferStatus(gl.FRAMEBUFFER) !== gl.FRAMEBUFFER_COMPLETE) simOn = false;
			gl.clearColor(0, 0, 0, 0); gl.clear(gl.COLOR_BUFFER_BIT);
			tex.push(t); fbo.push(f);
		}
		gl.bindFramebuffer(gl.FRAMEBUFFER, null);
	};

	// Size the canvas to cover the nav and hero, plus a little of the next section.
	// The pixel ratio is at most 1.5, kept within MAX_PIXELS, and scaled by `quality`,
	// which drops when the machine cannot keep up (see the frame loop).
	let W = 0, H = 0, dpr = 1, quality = 1;
	const resize = () => {
		const w = document.documentElement.clientWidth, h = Math.ceil(hero.getBoundingClientRect().bottom + scrollY + EXTRA);
		dpr = Math.min(Math.min(devicePixelRatio || 1, 1.5), Math.sqrt(MAX_PIXELS / (w * h))) * quality;
		const cw = Math.round(w * dpr), ch = Math.round(h * dpr);
		if (w === W && h === H && cv.width === cw && cv.height === ch) return;
		W = w; H = h; cv.style.height = H + 'px';
		cv.width = cw; cv.height = ch;
		cv.dataset.quality = quality.toFixed(2);
		if (simOn) { const nw = Math.ceil(W / CELL), nh = Math.ceil(H / CELL); if (nw !== sw || nh !== sh) { sw = nw; sh = nh; makeSim(); } }
		fitLeaves();
		if (!running) render(performance.now());
	};

	// The cursor does not touch the water directly. It pulls a wake point along on a damped spring,
	// and each simulation step the wake point pushes the water down along the path it just moved.
	// The spring makes the wake lag behind the cursor and swing a little when the cursor stops.
	let drop = null, target = null, wake = null, lastMove = 0;
	const toSim = (x, y) => { const r = cv.getBoundingClientRect(); return [(x - r.left) / CELL, (r.bottom - y) / CELL, x - r.left, y - r.top]; };
	const inside = (cx, cy) => cx >= 0 && cy >= 0 && cx <= W && cy <= H;
	addEventListener('pointermove', (e) => {
		if (!simOn) return;
		const [sx, sy, cx, cy] = toSim(e.clientX, e.clientY);
		if (!inside(cx, cy)) { target = null; return; }
		if (!wake) wake = { x: sx, y: sy, vx: 0, vy: 0 };   // first sight of the cursor: start the wake under it
		target = [sx, sy]; lastMove = performance.now();
	}, { passive: true });
	const moveWake = () => {
		if (!wake) return null;
		if (target) { wake.vx += (target[0] - wake.x) * PULL; wake.vy += (target[1] - wake.y) * PULL; }
		wake.vx *= DRAG; wake.vy *= DRAG;
		const a = [wake.x, wake.y];
		wake.x += wake.vx; wake.y += wake.vy;
		const speed = Math.hypot(wake.vx, wake.vy);              // texels per step
		if (!target && speed < 0.01) { wake = null; return null; }
		const str = Math.min(speed / 2.5, 1) * 0.28;
		return str > 0.01 ? { a, b: [wake.x, wake.y], r: 7, s: str } : null;
	};
	addEventListener('pointerdown', (e) => {
		if (!simOn) return;
		const [sx, sy, cx, cy] = toSim(e.clientX, e.clientY);
		if (inside(cx, cy)) { drop = { a: [sx, sy], b: [sx, sy], r: 10, s: 2.4 }; lastMove = performance.now(); }
	}, { passive: true });

	// With no cursor for a while, an occasional soft drop somewhere on the water.
	let nextIdle = performance.now() + 2500;
	const idleDrop = (now) => {
		if (now < nextIdle) return;
		nextIdle = now + 2600 + Math.random() * 3800;
		if (now - lastMove < 4000 || drop) return;
		const x = (0.15 + Math.random() * 0.8) * sw, y = (0.25 + Math.random() * 0.7) * sh;
		drop = { a: [x, y], b: [x, y], r: 9, s: 0.9 };
	};

	// Leaves. Positions are css px with y measured up from the bottom of the canvas, as in the shader.
	const leaves = [];
	const yLo = () => FADE * 0.75, yHi = () => H - 40;
	const rand = (a, b) => a + Math.random() * (b - a);
	const fitLeaves = () => {
		const narrow = W < 700, n = narrow ? 3 : 7;   // on phones the text spans the width, so fewer, smaller leaves
		while (leaves.length > n) leaves.pop();
		while (leaves.length < n) {
			const i = leaves.length;
			leaves.push({ x: (i + rand(0.15, 0.85)) / n * W, y: rand(yLo(), yHi()), vx: 0, vy: 0, a: rand(0, 6.283), va: rand(-0.004, 0.004),
				size: rand(LEAF_SIZE[0], LEAF_SIZE[1]) * (narrow ? 0.75 : 1), tint: rand(0, 0.55), h: 0, gx: 0, gy: 0 });
		}
		leaves.forEach((L) => { L.x = Math.min(L.x, W); L.y = Math.min(Math.max(L.y, yLo()), yHi()); });
	};
	const leafStep = () => {
		const cx = CURRENT[0] / 60, cy = CURRENT[1] / 60;
		for (const L of leaves) {
			// Water drag pulls the leaf toward the current; ripple slopes push it downhill.
			L.vx += (cx - L.vx) * 0.015 - L.gx * SLOPE;
			L.vy += (cy - L.vy) * 0.015 - L.gy * SLOPE;
			L.va += (L.gx * Math.cos(L.a) + L.gy * Math.sin(L.a)) * 0.15 + rand(-0.0002, 0.0002);
			// The cursor's wake shoves leaves out of its way and spins them.
			if (wake) {
				const dx = L.x - wake.x * CELL, dy = L.y - wake.y * CELL, d = Math.hypot(dx, dy) || 1, reach = L.size * 0.5 + 45;
				if (d < reach) {
					const k = 1 - d / reach, wvx = wake.vx * CELL, wvy = wake.vy * CELL, sp = Math.min(Math.hypot(wvx, wvy), 14);
					L.vx += (dx / d * sp * 0.025 + wvx * 0.02) * k;
					L.vy += (dy / d * sp * 0.025 + wvy * 0.02) * k;
					L.va += (dx * wvy - dy * wvx) / (d * reach) * 0.02 * k;
				}
			}
		}
		// Leaves nudge each other apart instead of overlapping.
		for (let i = 0; i < leaves.length; i++) for (let j = i + 1; j < leaves.length; j++) {
			const A = leaves[i], B = leaves[j], dx = B.x - A.x, dy = B.y - A.y, d = Math.hypot(dx, dy) || 1, min = (A.size + B.size) * 0.45;
			if (d < min) { const f = (min - d) * 0.004 / d; A.vx -= dx * f; A.vy -= dy * f; B.vx += dx * f; B.vy += dy * f; }
		}
		for (const L of leaves) {
			L.va *= 0.985;
			L.x += L.vx; L.y += L.vy; L.a += L.va;
			if (L.y < yLo()) L.vy += (yLo() - L.y) * 0.002;
			if (L.y > yHi()) L.vy -= (L.y - yHi()) * 0.002;
			// Off one side, back in on the other.
			if (L.x > W + L.size) { L.x = -L.size; L.y = rand(yLo(), yHi()); L.vx = cx; L.vy = cy; }
			else if (L.x < -L.size - 1) L.x = W + L.size;
		}
	};

	// Ask the GPU for the 3x3 ripple texels under each leaf, and collect an earlier request once it is ready.
	// Gradients are in height per texel; L.h is the height at the leaf's centre.
	// Each request gets a fresh small buffer: Chrome warns, and drops its fast path, when a fenced buffer is reused.
	let pbo = null, fence = null, readOn = simOn, firstRead = true;
	const rb = new Float32Array(8 * 36);
	const readSlopes = () => {
		if (!readOn) return;
		if (fence) {
			if (gl.clientWaitSync(fence, 0, 0) === gl.TIMEOUT_EXPIRED) return;
			gl.deleteSync(fence); fence = null;
			gl.bindBuffer(gl.PIXEL_PACK_BUFFER, pbo); gl.getBufferSubData(gl.PIXEL_PACK_BUFFER, 0, rb); gl.bindBuffer(gl.PIXEL_PACK_BUFFER, null);
			gl.deleteBuffer(pbo); pbo = null;
			leaves.forEach((L, i) => {
				const h = (r, c) => rb[i * 36 + (r * 3 + c) * 4];
				L.gx = (h(1, 2) - h(1, 0)) / 2; L.gy = (h(2, 1) - h(0, 1)) / 2; L.h = h(1, 1);
			});
		}
		const clamp = (v, lo, hi) => Math.max(lo, Math.min(hi, v));
		pbo = gl.createBuffer();
		gl.bindFramebuffer(gl.READ_FRAMEBUFFER, fbo[cur]); gl.bindBuffer(gl.PIXEL_PACK_BUFFER, pbo); gl.bufferData(gl.PIXEL_PACK_BUFFER, rb.byteLength, gl.STREAM_READ);
		leaves.forEach((L, i) => gl.readPixels(clamp(Math.round(L.x / CELL) - 1, 0, sw - 3), clamp(Math.round(L.y / CELL) - 1, 0, sh - 3), 3, 3, gl.RGBA, gl.FLOAT, i * 144));
		gl.bindBuffer(gl.PIXEL_PACK_BUFFER, null); gl.bindFramebuffer(gl.READ_FRAMEBUFFER, null);
		if (firstRead && gl.getError() !== gl.NO_ERROR) { readOn = false; gl.deleteBuffer(pbo); pbo = null; return; }   // this GPU cannot read float pixels back; leaves just drift
		firstRead = false;
		fence = gl.fenceSync(gl.SYNC_GPU_COMMANDS_COMPLETE, 0); gl.flush();
	};

	// The leaf shape: the logo drawn white on a transparent square, with room around it for the blurred shadow.
	const LEAF_FILL = 0.55;   // share of the texture the leaf fills
	const leafTex = gl.createTexture();
	let leafOn = false;
	const img = new Image();
	img.onload = () => {
		const S = 128, c2 = document.createElement('canvas'); c2.width = c2.height = S;
		const k = LEAF_FILL * S / Math.max(img.width, img.height);
		c2.getContext('2d').drawImage(img, (S - img.width * k) / 2, (S - img.height * k) / 2, img.width * k, img.height * k);
		gl.activeTexture(gl.TEXTURE1); gl.bindTexture(gl.TEXTURE_2D, leafTex);
		gl.pixelStorei(gl.UNPACK_FLIP_Y_WEBGL, true);
		gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA, gl.RGBA, gl.UNSIGNED_BYTE, c2);
		gl.pixelStorei(gl.UNPACK_FLIP_Y_WEBGL, false);
		gl.generateMipmap(gl.TEXTURE_2D);
		gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR_MIPMAP_LINEAR); gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, gl.LINEAR);
		gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE); gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);
		leafOn = true;
		if (!running) render(performance.now());
	};
	img.src = cv.dataset.leaf;

	const simStep = () => {
		const src = cur, dst = 1 - cur;
		gl.bindFramebuffer(gl.FRAMEBUFFER, fbo[dst]); gl.viewport(0, 0, sw, sh);
		gl.useProgram(step.p);
		gl.activeTexture(gl.TEXTURE0); gl.bindTexture(gl.TEXTURE_2D, tex[src]);
		gl.uniform1i(step.u.uState, 0); gl.uniform2f(step.u.uTexel, 1 / sw, 1 / sh); gl.uniform1f(step.u.uDamp, DAMP); gl.uniform1f(step.u.uWave, WAVE);
		if (!drop) drop = moveWake(); else moveWake();
		if (drop) { gl.uniform4f(step.u.uSeg, drop.a[0], drop.a[1], drop.b[0], drop.b[1]); gl.uniform2f(step.u.uDrop, drop.r, drop.s * 0.25); drop = null; }
		else gl.uniform2f(step.u.uDrop, 1, 0);
		gl.drawArrays(gl.TRIANGLES, 0, 3);
		cur = dst;
	};

	const t0 = performance.now();
	let running = false, raf = 0, last = 0, acc = 0;
	const render = (now) => {
		gl.bindFramebuffer(gl.FRAMEBUFFER, null); gl.viewport(0, 0, cv.width, cv.height);
		gl.useProgram(draw.p);
		const u = draw.u;
		gl.uniform2f(u.uSize, W, H); gl.uniform1f(u.uDpr, cv.width / W);
		gl.uniform1f(u.uTime, still ? 14 : (now - t0) / 1000);
		gl.uniform1f(u.uFade, FADE); gl.uniform1f(u.uFocus, FOCUS); gl.uniform1f(u.uRipple, RIPPLE); gl.uniform1f(u.uSpeed, SPEED);
		gl.uniform1f(u.uShade, SHADE); gl.uniform1f(u.uShine, SHINE); gl.uniform1f(u.uTint, TINT); gl.uniform1f(u.uRays, RAYS);
		gl.uniform1f(u.uCell, CELL); gl.uniform1f(u.uSimOn, simOn ? 1 : 0); gl.uniform2f(u.uSimSize, sw || 1, sh || 1);
		if (simOn) { gl.activeTexture(gl.TEXTURE0); gl.bindTexture(gl.TEXTURE_2D, tex[cur]); gl.uniform1i(u.uSim, 0); }
		gl.uniform1f(u.uLeafOn, leafOn ? 1 : 0);
		if (leafOn) {
			gl.activeTexture(gl.TEXTURE1); gl.bindTexture(gl.TEXTURE_2D, leafTex); gl.uniform1i(u.uLeafTex, 1);
			const A = new Float32Array(32), B = new Float32Array(32);
			leaves.forEach((L, i) => {
				const lift = Math.max(0.7, Math.min(1.3, 1 + L.h * LIFT));
				A.set([L.x, L.y, L.a, L.size / LEAF_FILL * lift], i * 4);
				B.set([L.tint, 0.92, lift, 0], i * 4);
			});
			gl.uniform4fv(u['uLeaf[0]'], A); gl.uniform4fv(u['uLeafB[0]'], B); gl.uniform1i(u.uLeafN, leaves.length);
		}
		gl.drawArrays(gl.TRIANGLES, 0, 3);
	};
	// The water updates 60 times a second, so the loop only draws on frames where it stepped.
	// On a 120Hz screen that skips every other frame. The 2ms of slack stops a 60Hz screen
	// from skipping a frame whenever one arrives a little early.
	//
	// It also watches the gap between draws. If the gap averages over SLOW_GAP ms for a while,
	// the GPU is falling behind, so the canvas drops to 80% resolution, down to at most half.
	let lastDraw = 0, gapAvg = 1000 / 60, settleUntil = 0;
	const frame = (now) => {
		if (!running) return;
		raf = requestAnimationFrame(frame);
		if (simOn) idleDrop(now);
		acc += Math.min((now - (last || now)) / 1000, 0.1);
		last = now;
		let stepped = false;
		while (acc >= 1 / 60 - 0.002) { if (simOn) simStep(); leafStep(); acc -= 1 / 60; stepped = true; }
		if (!stepped) return;
		if (simOn) readSlopes();
		render(now);
		const gap = now - lastDraw;
		lastDraw = now;
		if (gap > 250 || now < settleUntil) return;   // ignore pauses and the first moments after a start or change
		gapAvg = gapAvg * 0.95 + gap * 0.05;
		if (gapAvg > SLOW_GAP && quality > 0.55) { quality *= 0.8; gapAvg = 1000 / 60; settleUntil = now + 2000; resize(); }
	};

	// The water runs only while it is the chosen background (BgToggle sets <html data-bg>; a page
	// without the toggle always shows it) and while the canvas is on screen.
	const chosen = () => (document.documentElement.dataset.bg || 'water') === 'water';
	let onScreen = false, stopTimer = 0;
	const start = () => {
		if (running || still) return;
		running = true; last = 0; lastDraw = 0; settleUntil = performance.now() + 1500;
		raf = requestAnimationFrame(frame);
	};
	const stop = () => { running = false; cancelAnimationFrame(raf); };
	const apply = () => {
		const on = chosen();
		cv.classList.toggle('on', on);
		clearTimeout(stopTimer);
		if (on && onScreen) start();
		else if (!on) stopTimer = setTimeout(stop, 1500);   // keep moving while it fades out
	};

	resize();
	render(performance.now());
	new ResizeObserver(resize).observe(hero);
	addEventListener('resize', resize);
	addEventListener('bgchange', apply);
	cv.addEventListener('webglcontextlost', () => { stop(); cv.classList.remove('on'); });
	new IntersectionObserver((es) => {
		onScreen = es[0].isIntersecting;
		if (!onScreen) stop(); else if (chosen()) start();
	}).observe(cv);
	apply();
});
</script>
