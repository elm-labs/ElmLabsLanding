---
// Variant F — "Line". The page scrolls sideways along one production line. A token rides it from pilot to owned.
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const mail = 'mailto:jawwad@elmlabs.ai?subject=20%20minutes';
---
<html lang="en">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
	<title>Elm Labs — Keep AI working once it's live</title>
	<meta name="description" content="Elm Labs gets one critical AI workflow into production, proves it works, and lets you own it when you're ready." />
	<meta name="theme-color" content="#D9BF63" />
	<link rel="preconnect" href="https://fonts.googleapis.com" />
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
	<link href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@700;900&family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500&display=swap" rel="stylesheet" />
</head>
<body style={`--logo:url(${base}logofilledwhite.svg)`}>
	<header class="top">
		<a class="brand" href="#top"><span class="leaf"></span>Elm Labs</a>
		<span class="mono prog"><b id="pn">01</b> / 09 <i id="pname">Start</i></span>
		<a class="cta mono" href={mail}>Book 20 minutes →</a>
	</header>

	<div class="wrap" id="top">
		<div class="stage" id="stage">
			<div class="track" id="track">
				<svg id="line" aria-hidden="true"></svg>

				<section class="pn" data-n="Start">
					<h1>Keep AI working once it's live.</h1>
					<p class="lede">We get one critical workflow into production with your team. Then we prove, every day, that it still works.</p>
					<p class="mono hint">Scroll <span>→</span> follow one workflow down the line</p>
				</section>

				<section class="pn" data-n="The problem">
					<p class="mono lab">The problem</p>
					<h2>Pilots work.<br />Production stalls.</h2>
					<p>No one can prove the workflow is still working as models, data and processes change. Each change knocks quality. Nothing reports it.</p>
					<div class="under mono"><span style="left:30%">Model updated</span><span style="left:55%">New data</span><span style="left:80%">Process changed</span></div>
				</section>

				<section class="pn" data-n="Get it live">
					<p class="mono lab">Station 01</p>
					<h2>Get it live.</h2>
					<p>Our engineers embed in your team on one critical workflow. We build on the models you already use. Your users see no change on day one.</p>
				</section>

				<section class="pn" data-n="Prove it works">
					<p class="mono lab">Station 02</p>
					<h2>Prove it works.</h2>
					<p>We build evaluations from how your experts decide. They measure the workflow every day it runs.</p>
					<ul class="gauges mono"><li><b>Quality</b>against your experts</li><li><b>Drift</b>week on week</li><li><b>Cost</b>per task, per model</li></ul>
				</section>

				<section class="pn" data-n="Own it">
					<p class="mono lab">Station 03 · optional</p>
					<h2>Own it, when you're ready.</h2>
					<p>The same evaluations train open-weight models you host. Switch a task only when the owned model matches. Switch back any time.</p>
					<div class="under mono"><span style="left:52%;top:calc(var(--sh)*-.285)">Owned track</span><span style="left:52%">Rented track</span></div>
				</section>

				<section class="pn" data-n="Who it's for">
					<p class="mono lab">Who it's for</p>
					<div class="cols">
						<div><h3>Energy, utilities, industrials, construction.</h3><p>Proof and control. You have to show why the answer was right.</p></div>
						<div><h3>Fintech, neobanks, gaming.</h3><p>Reliability at scale, lower cost, and no single vendor setting your roadmap.</p></div>
					</div>
				</section>

				<section class="pn" data-n="How we start">
					<p class="mono lab">How we start</p>
					<h2>One workflow.<br />About a month.</h2>
					<p>You leave with hard evidence on quality, drift and cost. No production commitment.</p>
				</section>

				<section class="pn" data-n="Team">
					<p class="mono lab">Team · 10+ years at Palantir between them · Cambridge Engineering</p>
					<div class="cols">
						<div><h3>Jawwad Farid</h3><p>Palantir backend tech lead, Ontology infrastructure. Founding engineer at two AI startups.</p></div>
						<div><h3>Burhan Ashraf</h3><p>Palantir forward-deployed tech lead. Led one of its largest UK government accounts.</p></div>
					</div>
				</section>

				<section class="pn end" data-n="Terminus">
					<p class="mono lab">End of the line</p>
					<h2>Book 20 minutes.<br />No deck.</h2>
					<a class="mail" href={mail}>jawwad@elmlabs.ai →</a>
				</section>
			</div>
			<div class="tok" id="tok" aria-hidden="true"><i></i><span class="mono" id="tokl">pilot</span></div>
		</div>
	</div>

	<style is:global>
		:root{--bg:#D9BF63;--ink:#11301F;--rust:#A2371A;--cream:#FAF3E9;--pad:clamp(20px,5vw,84px);--sh:min(100vh,1000px)}
		*{box-sizing:border-box;margin:0;padding:0}
		body{background:var(--bg);color:var(--ink);font-family:'IBM Plex Sans',system-ui,sans-serif;font-size:18px;line-height:1.45;-webkit-font-smoothing:antialiased}
		a{color:inherit;text-decoration:none}
		.mono{font-family:'IBM Plex Mono',ui-monospace,monospace;font-size:12px;letter-spacing:.08em;text-transform:uppercase}
		.leaf{display:inline-block;width:.82em;height:1em;vertical-align:-.12em;margin-right:.4em;background:currentColor;-webkit-mask:var(--logo) center/contain no-repeat;mask:var(--logo) center/contain no-repeat}
		h1,h2,h3,.brand{font-family:'Big Shoulders Display',Impact,sans-serif;font-weight:900;text-transform:uppercase;line-height:.84;letter-spacing:-.01em}

		.top{position:fixed;top:0;left:0;right:0;z-index:10;display:flex;align-items:center;justify-content:space-between;padding:16px var(--pad);pointer-events:none}
		.top>*{pointer-events:auto}
		.brand{font-size:24px;letter-spacing:.01em}
		.prog b{font-weight:500}.prog i{font-style:normal;margin-left:14px;opacity:.7}
		.cta{background:var(--ink);color:var(--bg);padding:11px 16px}
		.cta:hover{background:var(--rust);color:var(--cream)}

		.stage{position:sticky;top:0;height:var(--sh);overflow:hidden}
		.track{position:relative;display:flex;height:100%;will-change:transform;background:repeating-linear-gradient(90deg,var(--ink) 0 1px,transparent 1px 24px) 0 100%/100% 10px no-repeat,repeating-linear-gradient(90deg,var(--ink) 0 1px,transparent 1px 240px) 0 100%/100% 22px no-repeat}
		#line{position:absolute;left:0;top:0;height:100%;pointer-events:none;z-index:1}
		body.dark .top{color:var(--bg)}
		body.dark .cta{background:var(--bg);color:var(--ink)}
		.pn{position:relative;flex:none;width:100vw;height:100%;padding:calc(var(--sh)*.14) var(--pad) 0}
		.pn>p:not(.mono){max-width:44ch;font-size:clamp(16px,min(1.5vw,2.4vh),21px)}
		.lab{margin-bottom:calc(var(--sh)*.022)}
		h1{font-size:clamp(3.2rem,min(13vw,22vh),14rem);max-width:16ch;margin-bottom:calc(var(--sh)*.03)}
		h2{font-size:clamp(2.8rem,min(11vw,18vh),11rem);margin-bottom:calc(var(--sh)*.03)}
		h3{font-size:clamp(1.8rem,min(4.6vw,7.4vh),4.6rem);line-height:.9;margin-bottom:14px}
		.lede{font-size:clamp(17px,min(1.7vw,2.7vh),24px)!important}
		.hint{position:absolute;left:var(--pad);top:calc(var(--sh)*.86)}
		.hint span{display:inline-block;animation:nudge 1.4s ease-in-out infinite}
		@keyframes nudge{50%{transform:translateX(8px)}}
		.under{position:absolute;left:0;right:0;top:calc(var(--sh)*.86)}
		.under span{position:absolute;transform:translateX(-50%);white-space:nowrap}
		.pn:nth-child(3) .under span{color:var(--rust)}
		.gauges{list-style:none;display:flex;gap:clamp(18px,3vw,48px);margin-top:calc(var(--sh)*.03);text-transform:none;letter-spacing:.02em}
		.gauges b{display:block;font:900 clamp(1.6rem,min(3vw,5vh),3rem)/1 'Big Shoulders Display',sans-serif;text-transform:uppercase;letter-spacing:0}
		.cols{display:grid;grid-template-columns:1fr 1fr;gap:clamp(24px,5vw,90px);max-width:1200px;margin-top:calc(var(--sh)*.03)}
		.cols p{max-width:36ch;font-size:clamp(16px,min(1.5vw,2.4vh),21px)}
		.end{background:var(--ink);color:var(--bg)}
		.mail{font-family:'IBM Plex Mono',monospace;font-size:clamp(1rem,2.2vw,1.9rem);border-bottom:2px solid currentColor;padding-bottom:4px}
		.mail:hover{color:var(--cream)}

		.tok{position:absolute;left:0;top:0;z-index:5;pointer-events:none;will-change:transform}
		.tok i{display:block;width:26px;height:26px;margin:-13px 0 0 -13px;border-radius:50%;background:var(--ink);border:5px solid var(--bg);box-shadow:0 0 0 3px var(--ink);transition:background .3s,box-shadow .3s}
		.tok span{position:absolute;left:24px;top:-34px;white-space:nowrap;background:var(--ink);color:var(--bg);padding:4px 9px;transition:background .3s}
		.tok.bad i{background:var(--rust);box-shadow:0 0 0 3px var(--rust)}
		.tok.bad span{background:var(--rust);color:var(--cream)}
		.tok.inv i{background:var(--bg);border-color:var(--ink);box-shadow:0 0 0 3px var(--bg)}
		.tok.inv span{background:var(--bg);color:var(--ink)}

		@media (max-width:860px){
			.wrap{height:auto!important}
			.top{position:absolute}
			.stage{position:static;height:auto;overflow:visible}
			.track{flex-direction:column;transform:none!important;background:none}
			#line,.tok,.under,.hint,.prog{display:none}
			.pn{width:100%;height:auto;padding:72px var(--pad) 56px;border-bottom:3px solid var(--ink)}
			.pn:first-child{padding-top:110px}
			.cols{grid-template-columns:1fr}
			.gauges{flex-direction:column;gap:14px}
			h1{font-size:23vw}h2{font-size:18vw}h3{font-size:10vw}
			.pn>p:not(.mono),.cols p{font-size:18px}
		}
		@media (prefers-reduced-motion:reduce){.hint span{animation:none}}
	</style>

	<script is:inline>
		(() => {
			const wrap = document.querySelector('.wrap'), stage = document.getElementById('stage'), track = document.getElementById('track'), svg = document.getElementById('line');
			const tok = document.getElementById('tok'), tokl = document.getElementById('tokl'), pn = document.getElementById('pn'), pname = document.getElementById('pname');
			const panels = [...document.querySelectorAll('.pn')], N = panels.length, B = 0.74, TX = 0.2;
			const narrow = () => innerWidth <= 860;
			const sm = (t) => { t = Math.max(0, Math.min(1, t)); return t * t * (3 - 2 * t); };
			// Height of the line, as a fraction of the stage, at panel position u.
			const yf = (u) => {
				let y = B;
				[1.3, 1.55, 1.8].forEach((c) => (y += 0.085 * Math.max(0, 1 - Math.abs(u - c) / 0.028)));
				if (u > 3.16 && u < 3.92) y += 0.034 * Math.sin((u - 3.16) * 46) * (1 - (u - 3.16) / 0.76);
				return y;
			};
			const yb = (u) => B - 0.13 * sm((u - 4.3) / 0.12) * (1 - sm((u - 4.82) / 0.12));
			let vw = 0, H = 0, max = 0;
			const build = () => {
				if (narrow()) { svg.innerHTML = ''; return; }
				vw = innerWidth; H = stage.clientHeight; const W = N * vw; max = W - vw;
				wrap.style.height = H + max + 'px';
				svg.setAttribute('width', W); svg.setAttribute('height', H); svg.setAttribute('viewBox', '0 0 ' + W + ' ' + H);
				const end = (N - 0.5) * vw; let d = '', b = '';
				const dark = (N - 1) * vw; let e = '';
				for (let x = dark; x <= end; x += 5) e += (e ? 'L' : 'M') + x + ' ' + (yf(x / vw) * H).toFixed(1);
				for (let x = 0; x <= dark; x += 5) d += (x ? 'L' : 'M') + x + ' ' + (yf(x / vw) * H).toFixed(1);
				for (let x = 4.3 * vw; x <= 4.94 * vw; x += 5) b += (b ? 'L' : 'M') + x + ' ' + (yb(x / vw) * H).toFixed(1);
				const ink = '#11301F', bg = '#D9BF63';
				let h = '<path d="' + d + '" fill="none" stroke="' + ink + '" stroke-width="4" stroke-linejoin="round"/>';
				h += '<path d="' + b + '" fill="none" stroke="' + ink + '" stroke-width="4" stroke-dasharray="2 9" stroke-linecap="round"/>';
				[2.06, 3.06, 4.06].forEach((u, i) => {
					const x = u * vw, y = B * H;
					h += '<circle cx="' + x + '" cy="' + y + '" r="15" fill="' + bg + '" stroke="' + ink + '" stroke-width="4"/>';
					h += '<text x="' + x + '" y="' + (y + 5) + '" text-anchor="middle" font-family="IBM Plex Mono" font-size="12" font-weight="500" fill="' + ink + '">0' + (i + 1) + '</text>';
				});
				h += '<path d="' + e + '" fill="none" stroke="' + bg + '" stroke-width="4"/>';
				h += '<circle cx="' + end + '" cy="' + B * H + '" r="20" fill="' + bg + '"/>';
				svg.innerHTML = h;
				move();
			};
			const move = () => {
				if (narrow()) return;
				const x = Math.max(0, Math.min(max, scrollY - wrap.offsetTop));
				track.style.transform = 'translate3d(' + -x + 'px,0,0)';
				const u = Math.min(N - 0.5, x / vw + TX), i = Math.min(N - 1, Math.floor(x / vw + 0.5));
				tok.style.transform = 'translate3d(' + vw * TX + 'px,' + yf(u) * H + 'px,0)';
				tok.classList.toggle('inv', u > N - 1);
				const bad = u > 1.22 && u < 2.06;
				tok.classList.toggle('bad', bad);
				tokl.textContent = u < 1.22 ? 'pilot' : bad ? 'in production · unverified' : u < 3.06 ? 'live' : u < 4.06 ? 'live · proven' : 'live · proven · yours to own';
				document.body.classList.toggle('dark', x / vw > N - 1.12);
				pn.textContent = String(i + 1).padStart(2, '0'); pname.textContent = panels[i].dataset.n;
			};
			addEventListener('scroll', move, { passive: true });
			addEventListener('resize', build);
			document.fonts && document.fonts.ready.then(build);
			build();
		})();
	</script>
</body>
</html>
