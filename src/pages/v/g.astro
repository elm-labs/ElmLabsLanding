---
// Variant G — "Checks". Brand green ground, gold highlights, coral accent. A wall of evaluation checks that fail and heal.
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const mail = 'mailto:jawwad@elmlabs.ai?subject=20%20minutes';
---
<html lang="en">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
	<title>Elm Labs — AI you can trust in production</title>
	<meta name="description" content="Elm Labs engineers embed in your team, take one critical AI workflow into production, and build the evidence that it keeps working." />
	<meta name="theme-color" content="#153B2E" />
	<meta name="color-scheme" content="dark" />
	<link rel="preconnect" href="https://fonts.googleapis.com" />
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
	<link href="https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:wght@400;500;700;900&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet" />
	<noscript><style>.rv{opacity:1!important;transform:none!important}</style></noscript>
</head>
<body style={`--logo:url(${base}logofilledwhite.svg)`}>
	<header class="nav">
		<a class="brand" href="#top"><span class="leaf"></span>Elm Labs</a>
		<nav>
			<a href="#problem">Problem</a>
			<a href="#approach">Approach</a>
			<a href="#who">Who it's for</a>
			<a href="#start">How we start</a>
			<a href="#team">Team</a>
		</nav>
		<a class="btn sm" href={mail}>Book 20 minutes</a>
	</header>

	<main id="top">
		<section class="hero">
			<div class="hero-l">
				<p class="mono rv">Production AI engineering · UK</p>
				<h1 class="rv">AI you can <em>trust</em> in production.</h1>
				<p class="lede rv">Pilots work. Production is where AI stalls, because nobody can prove it still works as models, data and processes change. We get one critical workflow live with your team, then build the evidence that it stays good.</p>
				<div class="cta-row rv">
					<a class="btn" href={mail}>Book 20 minutes <span>→</span></a>
					<span class="mono">No deck</span>
				</div>
			</div>
			<div class="wall rv" aria-label="Illustrative wall of evaluation checks">
				<canvas id="wall"></canvas>
				<div class="wall-foot mono">
					<span id="st"><i class="pip"></i>All 264 checks passing</span>
					<span class="dim">Illustrative</span>
				</div>
			</div>
		</section>

		<section class="sec" id="problem">
			<p class="mono lab rv">01 — The problem</p>
			<h2 class="rv">A demo proves it worked once. Production asks whether it still works <em>today.</em></h2>
			<div class="three">
				<div class="rv"><h3>Models change.</h3><p>Your vendor ships a new version. The same prompt now gives a different answer.</p></div>
				<div class="rv"><h3>Data changes.</h3><p>A new source arrives, in a new format, with an edge case nobody tested.</p></div>
				<div class="rv"><h3>Processes change.</h3><p>The policy moves. Yesterday's right answer is today's wrong one.</p></div>
			</div>
		</section>

		<section class="sec" id="approach">
			<p class="mono lab rv">02 — Approach</p>
			<h2 class="rv">Get it live. Prove it works. Own it when you're ready.</h2>
			<div class="steps">
				<article class="s s1 rv">
					<span class="mono">01</span>
					<h3>Get it live</h3>
					<p>Our engineers embed in your team and take one critical workflow into production, on the models you already use. Nothing changes for your users on day one.</p>
				</article>
				<article class="s s2 rv">
					<span class="mono">02</span>
					<h3>Prove it works</h3>
					<p>We build evaluations from how your experts decide. They track quality, drift and cost every day the workflow runs.</p>
				</article>
				<article class="s s3 rv">
					<span class="mono">03 <i>Optional</i></span>
					<h3>Own it</h3>
					<p>The same evaluations train open-weight models you host. Switch only when they match the ones you rent. Switch back any time.</p>
				</article>
			</div>
		</section>

		<section class="sec" id="who">
			<p class="mono lab rv">03 — Who it's for</p>
			<div class="who">
				<div class="rv">
					<p class="mono tag">Proof and control</p>
					<h3>Energy, utilities, industrials and construction.</h3>
					<p>Your decisions carry safety, regulatory or contractual weight. You have to show a board, an auditor or a client why the answer was right.</p>
				</div>
				<div class="rv">
					<p class="mono tag">Reliability at scale</p>
					<h3>Fintech, neobanks and gaming.</h3>
					<p>AI already runs in your customer-facing work. You want quality held steady, spend under control, and no single vendor setting your roadmap.</p>
				</div>
			</div>
		</section>

		<section class="start" id="start">
			<p class="mono lab rv">04 — How we start</p>
			<h2 class="rv">One workflow. About a month.</h2>
			<div class="ev">
				<div class="rv"><b>Quality</b><p>How often the work matches what your experts would have done.</p></div>
				<div class="rv"><b>Drift</b><p>How that number moves when the model, the data or the process changes.</p></div>
				<div class="rv"><b>Cost</b><p>What each task costs today, and what it would cost on other models.</p></div>
			</div>
			<p class="nc rv">You leave with hard evidence on all three. No production commitment.</p>
		</section>

		<section class="sec" id="team">
			<p class="mono lab rv">05 — Team</p>
			<h2 class="rv">Ten-plus years at Palantir between us. Both Cambridge engineers.</h2>
			<div class="who">
				<div class="rv"><h3>Jawwad Farid</h3><p>Backend tech lead at Palantir, on Ontology infrastructure. Founding engineer at two AI startups.</p></div>
				<div class="rv"><h3>Burhan Ashraf</h3><p>Forward-deployed tech lead at Palantir. Led one of its largest UK government accounts.</p></div>
			</div>
		</section>

		<section class="close">
			<h2 class="rv">Book 20 minutes.<br />No deck.</h2>
			<a class="mail rv" href={mail}>jawwad@elmlabs.ai <span>→</span></a>
		</section>
	</main>
	<footer class="foot mono"><span><span class="leaf"></span>Elm Labs</span><a href="https://www.linkedin.com/company/elm-labs-ai" target="_blank" rel="noopener noreferrer">LinkedIn</a><span>© 2026</span></footer>

	<style is:global>
		:root{--sage:#E8C96A;--mint:#8FD6B2;--cream:#F7F5EE;--brick:#ED6A5A;--night:#153B2E;--soft:rgba(247,245,238,.74);--line:rgba(247,245,238,.18);--pad:clamp(18px,4vw,64px)}
		*{box-sizing:border-box;margin:0;padding:0}
		html{scroll-behavior:smooth}
		body{background:var(--night);color:var(--cream);font-family:'Schibsted Grotesk',system-ui,sans-serif;font-size:17.5px;line-height:1.5;-webkit-font-smoothing:antialiased}
		a{color:inherit;text-decoration:none}
		em{font-style:normal;color:var(--sage)}
		.mono{font-family:'DM Mono',ui-monospace,monospace;font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:var(--soft)}
		.dim{opacity:.6}
		.leaf{display:inline-block;width:.82em;height:1em;vertical-align:-.12em;margin-right:.4em;background:var(--brick);-webkit-mask:var(--logo) center/contain no-repeat;mask:var(--logo) center/contain no-repeat}
		.rv{opacity:0;transform:translateY(22px);transition:opacity .9s cubic-bezier(.2,.7,.2,1),transform .9s cubic-bezier(.2,.7,.2,1)}
		.rv.in{opacity:1;transform:none}

		.nav{position:sticky;top:0;z-index:20;display:flex;align-items:center;justify-content:space-between;gap:24px;padding:14px var(--pad);background:rgba(21,59,46,.86);backdrop-filter:blur(12px);border-bottom:1px solid var(--line)}
		.brand{font-weight:700;font-size:19px;letter-spacing:-.02em}
		.nav nav{display:flex;gap:28px;font-size:14.5px;color:var(--soft)}
		.nav nav a:hover{color:var(--cream)}
		.btn{display:inline-flex;align-items:center;gap:10px;background:var(--brick);color:#0F2A20;padding:16px 26px;border-radius:999px;font-weight:700;font-size:16.5px;transition:transform .2s,box-shadow .25s,background .2s}
		.btn:hover{transform:translateY(-2px);background:#F58372;box-shadow:0 14px 44px rgba(237,106,90,.45)}
		.btn span{transition:transform .2s}.btn:hover span{transform:translateX(4px)}
		.btn.sm{padding:9px 17px;font-size:14px}

		.hero{display:grid;grid-template-columns:1fr 1fr;gap:clamp(28px,4vw,72px);align-items:center;padding:clamp(40px,6vw,96px) var(--pad) clamp(48px,6vw,100px)}
		.hero .mono{margin-bottom:24px}
		h1{font-size:clamp(3rem,7.4vw,7.6rem);font-weight:900;line-height:.9;letter-spacing:-.05em;margin-bottom:28px}
		.lede{font-size:clamp(17px,1.4vw,20.5px);color:var(--soft);max-width:50ch;line-height:1.5}
		.cta-row{display:flex;align-items:center;gap:20px;margin-top:34px}
		.cta-row .mono{margin:0}
		.wall{border:1px solid var(--line);border-radius:18px;padding:clamp(14px,1.6vw,24px);background:linear-gradient(160deg,rgba(143,214,178,.12),rgba(10,32,24,.35))}
		#wall{display:block;width:100%;aspect-ratio:22/13}
		.wall-foot{display:flex;justify-content:space-between;gap:16px;margin-top:16px;padding-top:14px;border-top:1px solid var(--line);text-transform:none;letter-spacing:.02em;font-size:13px}
		#st{color:var(--cream)}
		.pip{display:inline-block;width:9px;height:9px;border-radius:2px;background:var(--mint);margin-right:10px;transition:background .3s}
		#st.bad .pip{background:var(--brick)}

		.sec{padding:clamp(64px,9vw,140px) var(--pad) 0}
		.lab{color:var(--sage);margin-bottom:22px}
		h2{font-size:clamp(2.1rem,4.9vw,5rem);font-weight:900;line-height:.96;letter-spacing:-.045em;max-width:17ch;margin-bottom:clamp(32px,4.5vw,68px)}
		h3{font-size:clamp(1.3rem,1.9vw,1.8rem);font-weight:700;letter-spacing:-.03em;line-height:1.1;margin-bottom:10px}
		.three{display:grid;grid-template-columns:repeat(3,1fr);gap:clamp(18px,3vw,48px)}
		.three>div{border-top:3px solid var(--brick);padding-top:20px}
		.three p,.who p:not(.mono){color:var(--soft)}

		.steps{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}
		.s{border-radius:22px;padding:clamp(22px,2.4vw,36px);min-height:380px;display:flex;flex-direction:column;transition:transform .35s}
		.s:hover{transform:translateY(-6px)}
		.s .mono{color:inherit;opacity:.8}
		.s h3{font-size:clamp(2rem,3.5vw,3.4rem);font-weight:900;letter-spacing:-.05em;line-height:.94;margin:auto 0 16px;padding-top:60px}
		.s1{background:var(--sage);color:#0F2A20}
		.s2{background:var(--cream);color:var(--night)}
		.s3{border:1.5px solid var(--line);background:rgba(10,32,24,.35)}
		.s3 p{color:var(--soft)}
		.s3 i{font-style:normal;margin-left:10px;border:1px solid var(--brick);color:var(--brick);border-radius:999px;padding:2px 9px;font-size:10.5px}

		.who{display:grid;grid-template-columns:1fr 1fr;gap:clamp(24px,5vw,90px)}
		.who>div{border-top:1px solid var(--line);padding-top:22px}
		.who h3{font-size:clamp(1.6rem,3vw,2.8rem);font-weight:900;letter-spacing:-.045em;line-height:1;margin-bottom:16px}
		.who p:not(.mono){max-width:44ch}
		.tag{color:var(--sage);margin-bottom:clamp(28px,4vw,56px)}

		.start{margin:clamp(64px,9vw,140px) 10px 0;border-radius:28px;background:var(--cream);color:var(--night);padding:clamp(40px,6vw,96px) calc(var(--pad) - 10px)}
		.start .lab{color:#C4432F}
		.start h2{font-size:clamp(2.6rem,8vw,8.4rem);max-width:none;line-height:.9}
		.ev{display:grid;grid-template-columns:repeat(3,1fr);gap:clamp(18px,3vw,48px)}
		.ev div{border-top:3px solid var(--night);padding-top:16px}
		.ev b{display:block;font-size:clamp(1.5rem,2.4vw,2.2rem);font-weight:900;letter-spacing:-.04em;margin-bottom:6px}
		.ev p{color:#3D5247;max-width:32ch}
		.nc{margin-top:clamp(28px,4vw,56px);font-weight:700;font-size:clamp(18px,1.6vw,22px)}

		.close{margin:clamp(64px,9vw,140px) 10px 0;border-radius:28px;background:var(--brick);color:#0F2A20;padding:clamp(56px,9vw,150px) calc(var(--pad) - 10px)}
		.close h2{font-size:clamp(3rem,10.5vw,11rem);line-height:.88;max-width:none;margin-bottom:clamp(28px,4vw,56px)}
		.mail{font-size:clamp(1.2rem,2.8vw,2.4rem);font-weight:700;letter-spacing:-.03em;border-bottom:3px solid currentColor;padding-bottom:4px}
		.mail span{display:inline-block;transition:transform .25s}.mail:hover span{transform:translateX(10px)}
		.foot{display:flex;justify-content:space-between;padding:26px var(--pad)}

		@media (max-width:900px){
			.nav nav{display:none}
			.hero,.three,.steps,.who,.ev{grid-template-columns:1fr}
			.s{min-height:260px}
		}
		@media (prefers-reduced-motion:reduce){.rv{opacity:1;transform:none;transition:none}html{scroll-behavior:auto}}
	</style>

	<script is:inline>
		const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }), { threshold: 0.12 });
		document.querySelectorAll('.rv').forEach((el, i) => { el.style.transitionDelay = (i % 3) * 80 + 'ms'; io.observe(el); });

		// The wall: 264 checks. On a 10-second loop a change fails a cluster, then they are fixed one by one. Illustrative.
		(() => {
			const cv = document.getElementById('wall'), g = cv.getContext('2d'), st = document.getElementById('st');
			const C = 22, R = 12, T = 10, still = matchMedia('(prefers-reduced-motion:reduce)').matches;
			const EV = ['Model updated', 'New data source', 'Process changed'];
			let s = 3; const rnd = () => ((s = (s * 16807) % 2147483647) / 2147483647);
			const tone = Array.from({ length: C * R }, () => 0.55 + rnd() * 0.45);
			let cycle = -1, fails = [], msg = '';
			const pick = (k) => {
				const cx = 3 + Math.floor(rnd() * (C - 6)), cy = 2 + Math.floor(rnd() * (R - 4)), out = [];
				for (let y = 0; y < R; y++) for (let x = 0; x < C; x++) { const d = Math.hypot(x - cx, (y - cy) * 1.2); if (d < 1.2 + rnd() * 2.1) out.push({ i: y * C + x, d }); }
				out.sort((a, b) => a.d - b.d); fails = out.map((o, n) => ({ i: o.i, on: 1.6 + o.d * 0.18, off: 4.4 + ((out.length - n) / out.length) * 3.4 }));
			};
			const say = (t, bad) => { if (t !== msg) { msg = t; st.lastChild.textContent = t; st.classList.toggle('bad', bad); } };
			const frame = (now) => {
				const t = still ? 3.4 : now / 1000, k = Math.floor(t / T), c = t - k * T;
				if (k !== cycle) { cycle = k; pick(k); }
				const dpr = Math.min(2, devicePixelRatio || 1), w = cv.clientWidth, h = cv.clientHeight;
				if (cv.width !== Math.round(w * dpr)) { cv.width = Math.round(w * dpr); cv.height = Math.round(h * dpr); }
				g.setTransform(dpr, 0, 0, dpr, 0, 0); g.clearRect(0, 0, w, h);
				const cw = w / C, ch = h / R, gap = Math.max(2, cw * 0.14), state = new Map();
				let bad = 0;
				fails.forEach((f) => { if (c >= f.on && c < f.off) { state.set(f.i, 1); bad++; } else if (c >= f.off && c < f.off + 0.5) state.set(f.i, 2); });
				for (let i = 0; i < C * R; i++) {
					const x = (i % C) * cw + gap / 2, y = Math.floor(i / C) * ch + gap / 2, v = state.get(i);
					g.fillStyle = v === 1 ? '#ED6A5A' : v === 2 ? '#FFFFFF' : 'rgba(143,214,178,' + tone[i] * (0.82 + 0.18 * Math.sin(t * 1.3 + i * 0.7)) + ')';
					g.beginPath(); g.roundRect ? g.roundRect(x, y, cw - gap, ch - gap, 3) : g.rect(x, y, cw - gap, ch - gap); g.fill();
				}
				const name = EV[((k % 3) + 3) % 3];
				if (c < 1.6) say('All 264 checks passing', false);
				else if (c < 4.4) say(name + '. ' + bad + ' checks failing', true);
				else if (bad > 0) say('Fixing. ' + bad + ' left', true);
				else say('All passing again. No user saw it.', false);
				if (!still) requestAnimationFrame(frame);
			};
			requestAnimationFrame(frame);
		})();
	</script>
</body>
</html>
