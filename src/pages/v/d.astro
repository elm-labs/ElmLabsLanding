---
// Variant D — "Rings". Leads with ownership. Dark forest, serif, a growing tree-ring drawing.
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const mail = 'mailto:jawwad@elmlabs.ai?subject=20%20minutes';
---
<html lang="en">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
	<title>Elm Labs — Own your AI. Don't rent it.</title>
	<meta name="description" content="Elm Labs helps enterprises capture the judgment in their work, prove it, and run it on models they control." />
	<meta name="theme-color" content="#0E2A20" />
	<meta name="color-scheme" content="dark" />
	<link rel="preconnect" href="https://fonts.googleapis.com" />
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
	<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;1,9..144,300;1,9..144,400&family=IBM+Plex+Mono:wght@400;500&family=Inter:wght@400;500&display=swap" rel="stylesheet" />
	<noscript><style>.rv{opacity:1!important;transform:none!important}</style></noscript>
</head>
<body style={`--logo:url(${base}logofilledwhite.svg)`}>
	<header class="nav">
		<a class="brand" href="#top"><span class="leaf"></span>Elm Labs</a>
		<nav class="mono">
			<a href="#rent">Rent or own</a>
			<a href="#path">The path</a>
			<a href="#now">Why now</a>
			<a href="#team">Team</a>
		</nav>
		<a class="link mono" href={mail}>Book 20 minutes ↗</a>
	</header>

	<main id="top">
		<section class="hero">
			<canvas id="rings" aria-hidden="true"></canvas>
			<div class="hero-in">
				<h1 class="rv">Own your AI.<br /><em>Don't rent it.</em></h1>
				<p class="lede rv">The judgment in your company's work is an asset. We help you capture it, prove it, and run it on models you control.</p>
				<a class="btn rv" href={mail}>Book 20 minutes <span>→</span></a>
			</div>
			<div class="legend mono rv">
				<p><i class="lg"></i>One ring: one round of your experts' decisions, recorded</p>
				<p><i class="lg gold"></i>Gold ring: a model was replaced. The record carries on.</p>
			</div>
		</section>

		<section class="creed">
			<p class="rv">Models are replaced every few months.</p>
			<p class="rv">What your experts know should <em>not go with them.</em></p>
		</section>

		<section class="sec" id="rent">
			<p class="mono lab rv">I. — Rent or own</p>
			<h2 class="rv">A rented model works until someone else changes it.</h2>
			<div class="tbl rv">
				<div class="th mono"><span></span><span>Rented</span><span>Owned</span></div>
				<div class="tr"><span class="mono">Price</span><span>Set by the vendor. No cap on spend.</span><span>Set by your hardware. Capped.</span></div>
				<div class="tr"><span class="mono">Terms</span><span>Reviewed again with every new model.</span><span>Yours. Nothing to renegotiate.</span></div>
				<div class="tr"><span class="mono">Data</span><span>Leaves your environment.</span><span>Stays where it is.</span></div>
				<div class="tr"><span class="mono">Roadmap</span><span>Theirs. Versions retire on their schedule.</span><span>Yours. Change when you choose.</span></div>
				<div class="tr"><span class="mono">Quality</span><span>Whatever the next version does.</span><span>Measured against your own experts.</span></div>
			</div>
		</section>

		<section class="sec" id="path">
			<p class="mono lab rv">II. — The path</p>
			<h2 class="rv">You don't start by owning. You start by <em>getting one thing to work.</em></h2>
			<ol class="path">
				<li class="rv">
					<span class="mono">First</span>
					<h3>Get it live</h3>
					<p>Our engineers embed in your team on one critical workflow, on the models you already use.</p>
				</li>
				<li class="rv">
					<span class="mono">Then</span>
					<h3>Prove it works</h3>
					<p>We build evaluations from how your experts decide. They track quality, drift and cost in production.</p>
				</li>
				<li class="rv">
					<span class="mono">When you're ready</span>
					<h3>Own it</h3>
					<p>The same evaluations train open-weight models you host. Switch only when they match. Switch back any time.</p>
				</li>
			</ol>
			<p class="aside rv">Steps one and two commit you to nothing. They are worth doing on their own.</p>
		</section>

		<section class="sec" id="now">
			<p class="mono lab rv">III. — Why now</p>
			<div class="now">
				<h2 class="rv">Four things changed.</h2>
				<ul>
					<li class="rv"><b>Spend has no ceiling.</b> Token bills grow with usage. Hardware you host is a fixed cost.</li>
					<li class="rv"><b>Terms keep moving.</b> Each new model brings a new legal review. One vendor means no leverage.</li>
					<li class="rv"><b>Process is the edge.</b> Companies whose advantage is how they work don't want that leaving the building.</li>
					<li class="rv"><b>Open models are closing the gap.</b> Tuned on your own work, they can match rented models on the tasks that matter to you.</li>
				</ul>
			</div>
		</section>

		<section class="sec" id="who">
			<p class="mono lab rv">IV. — Who we work with</p>
			<div class="who">
				<div class="rv"><h3>Energy, utilities, industrials, construction</h3><p>For proof and control. Decisions here carry weight, and the data should stay home.</p></div>
				<div class="rv"><h3>Fintech, neobanks, gaming</h3><p>For reliability at scale, lower cost and independence from any one vendor.</p></div>
				<div class="rv"><h3>How it starts</h3><p>One workflow. About a month. Hard evidence on quality, drift and cost. No production commitment.</p></div>
			</div>
		</section>

		<section class="sec" id="team">
			<p class="mono lab rv">V. — Team</p>
			<div class="team">
				<h2 class="rv">Two engineers. Ten-plus years at Palantir between them.</h2>
				<div>
					<div class="p rv"><h3>Jawwad Farid</h3><p>Palantir backend tech lead on Ontology infrastructure. Founding engineer at two AI startups. Cambridge Engineering.</p></div>
					<div class="p rv"><h3>Burhan Ashraf</h3><p>Palantir forward-deployed tech lead. Led one of its largest UK government accounts. Cambridge Engineering.</p></div>
				</div>
			</div>
		</section>

		<section class="close">
			<h2 class="rv">Book 20 minutes.<br /><em>No deck.</em></h2>
			<a class="mail rv" href={mail}>jawwad@elmlabs.ai</a>
		</section>
	</main>
	<footer class="foot mono"><span><span class="leaf"></span>Elm Labs · United Kingdom</span><a href="https://www.linkedin.com/company/elm-labs-ai" target="_blank" rel="noopener noreferrer">LinkedIn</a><span>© 2026</span></footer>

	<style is:global>
		:root{--bg:#0E2A20;--deep:#0A2018;--cream:#F3EBDB;--soft:rgba(243,235,219,.66);--line:rgba(243,235,219,.16);--gold:#D4B866;--pad:clamp(20px,5vw,84px)}
		*{box-sizing:border-box;margin:0;padding:0}
		html{scroll-behavior:smooth}
		body{background:var(--bg);color:var(--cream);font-family:'Inter',system-ui,sans-serif;font-size:17px;line-height:1.6;-webkit-font-smoothing:antialiased}
		a{color:inherit;text-decoration:none}
		h1,h2,h3,.creed,.mail{font-family:'Fraunces',Georgia,serif;font-weight:300;font-variation-settings:'opsz' 144}
		em{font-style:italic;color:var(--gold)}
		.mono{font-family:'IBM Plex Mono',ui-monospace,monospace;font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:var(--soft)}
		.leaf{display:inline-block;width:.82em;height:1em;vertical-align:-.12em;margin-right:.45em;background:currentColor;-webkit-mask:var(--logo) center/contain no-repeat;mask:var(--logo) center/contain no-repeat}
		.rv{opacity:0;transform:translateY(20px);transition:opacity 1.2s ease,transform 1.2s cubic-bezier(.2,.7,.2,1)}
		.rv.in{opacity:1;transform:none}

		.nav{position:absolute;top:0;left:0;right:0;z-index:5;display:flex;align-items:center;justify-content:space-between;gap:24px;padding:24px var(--pad)}
		.brand{font-family:'Fraunces',serif;font-size:21px;letter-spacing:-.01em}
		.nav nav{display:flex;gap:32px}
		.nav a:hover{color:var(--cream)}
		.link{color:var(--cream);border-bottom:1px solid var(--line);padding-bottom:3px}

		.hero{position:relative;min-height:min(100vh,1000px);display:flex;flex-direction:column;justify-content:flex-end;padding:120px var(--pad) clamp(28px,4vw,56px);overflow:hidden;background:radial-gradient(ellipse at 76% 44%,#17402F 0%,var(--bg) 62%)}
		#rings{position:absolute;inset:0;width:100%;height:100%}
		.hero-in{position:relative;z-index:2;max-width:820px}
		h1{font-size:clamp(3.4rem,9.2vw,9.6rem);line-height:.92;letter-spacing:-.04em;margin-bottom:clamp(22px,3vw,40px)}
		h1 em{letter-spacing:-.015em}
		.lede{font-size:clamp(18px,1.55vw,22px);line-height:1.5;color:var(--soft);max-width:44ch;margin-bottom:34px}
		.btn{display:inline-flex;align-items:center;gap:12px;border:1px solid var(--cream);border-radius:999px;padding:15px 26px;font-size:16px;font-weight:500;transition:background .3s,color .3s}
		.btn:hover{background:var(--cream);color:var(--bg)}
		.btn span{transition:transform .2s}.btn:hover span{transform:translateX(4px)}
		.legend{position:relative;z-index:2;display:flex;gap:36px;flex-wrap:wrap;margin-top:clamp(36px,6vw,80px);padding-top:16px;border-top:1px solid var(--line);text-transform:none;letter-spacing:.02em}
		.lg{display:inline-block;width:14px;height:14px;border-radius:50%;border:1.5px solid var(--cream);vertical-align:-2px;margin-right:10px;opacity:.8}
		.lg.gold{border-color:var(--gold);opacity:1}

		.creed{padding:clamp(90px,14vw,230px) var(--pad);font-size:clamp(2rem,5.4vw,5.4rem);line-height:1.08;letter-spacing:-.03em;max-width:1300px}
		.creed p:first-child{color:var(--soft)}

		.sec{padding:clamp(60px,8vw,130px) var(--pad);border-top:1px solid var(--line)}
		.lab{color:var(--gold);margin-bottom:clamp(24px,3vw,44px)}
		h2{font-size:clamp(2rem,4.4vw,4.3rem);line-height:1.05;letter-spacing:-.02em;max-width:20ch;margin-bottom:clamp(32px,4.5vw,68px)}
		h3{font-size:clamp(1.5rem,2.3vw,2.2rem);line-height:1.1;letter-spacing:-.02em;margin-bottom:12px}

		.tbl{border-top:1px solid var(--cream)}
		.th,.tr{display:grid;grid-template-columns:140px 1fr 1fr;gap:clamp(16px,3vw,48px);padding:20px 0;border-bottom:1px solid var(--line);align-items:baseline}
		.th span:nth-child(3){color:var(--gold)}
		.tr span:nth-child(2){color:var(--soft);font-size:clamp(17px,1.5vw,21px)}
		.tr span:nth-child(3){font-family:'Fraunces',serif;font-weight:300;font-size:clamp(1.3rem,2.3vw,2.1rem);line-height:1.15;letter-spacing:-.02em}
		.tr{transition:padding .3s,background .3s}
		.tr:hover{background:rgba(243,235,219,.04);padding-left:12px}

		.path{list-style:none;display:grid;grid-template-columns:repeat(3,1fr);gap:clamp(20px,3vw,48px)}
		.path li{border-top:1px solid var(--cream);padding-top:18px}
		.path li:last-child{border-color:var(--gold)}
		.path li:last-child .mono{color:var(--gold)}
		.path h3{margin-top:clamp(36px,5vw,80px);font-size:clamp(1.9rem,3.2vw,3.1rem)}
		.path p,.who p,.p p,.now li{color:var(--soft)}
		.aside{font-family:'Fraunces',serif;font-style:italic;font-weight:300;font-size:clamp(1.2rem,1.9vw,1.7rem);line-height:1.35;max-width:38ch;margin:clamp(40px,5vw,80px) 0 0 auto;color:var(--cream)}

		.now{display:grid;grid-template-columns:1fr 1.3fr;gap:var(--pad)}
		.now ul{list-style:none}
		.now li{padding:22px 0;border-top:1px solid var(--line);font-size:clamp(17px,1.4vw,20px)}
		.now b{display:block;font-family:'Fraunces',serif;font-weight:300;font-size:clamp(1.4rem,2.2vw,2rem);color:var(--cream);letter-spacing:-.02em;margin-bottom:4px}
		.who{display:grid;grid-template-columns:repeat(3,1fr);gap:clamp(20px,3vw,48px)}
		.who>div:last-child{background:var(--cream);color:var(--bg);padding:26px;border-radius:3px;margin-top:-26px}
		.who>div:last-child p{color:#3d5247}
		.team{display:grid;grid-template-columns:1fr 1.3fr;gap:var(--pad)}
		.p{padding:22px 0;border-top:1px solid var(--line)}
		.p p{max-width:48ch}

		.close{padding:clamp(90px,13vw,220px) var(--pad);text-align:center;background:var(--deep);border-top:1px solid var(--line)}
		.close h2{font-size:clamp(3rem,9vw,9.4rem);line-height:.94;letter-spacing:-.04em;max-width:none;margin-bottom:clamp(28px,4vw,56px)}
		.mail{font-size:clamp(1.3rem,3vw,2.6rem);font-style:italic;border-bottom:1px solid var(--gold);padding-bottom:6px;transition:color .3s}
		.mail:hover{color:var(--gold)}
		.foot{display:flex;justify-content:space-between;padding:24px var(--pad);background:var(--deep);border-top:1px solid var(--line)}

		@media (max-width:860px){
			.nav nav{display:none}
			.path,.who,.now,.team{grid-template-columns:1fr}
			.who>div:last-child{margin-top:0}
			.th,.tr{grid-template-columns:1fr 1fr}
			.th span:first-child{display:none}
			.tr .mono{grid-column:1/-1;margin-bottom:-8px}
			.aside{margin-left:0}
			.path h3{margin-top:20px}
		}
		@media (prefers-reduced-motion:reduce){.rv{opacity:1;transform:none;transition:none}html{scroll-behavior:auto}}
	</style>

	<script is:inline>
		const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }), { threshold: 0.12 });
		document.querySelectorAll('.rv').forEach((el, i) => { el.style.transitionDelay = (i % 3) * 110 + 'ms'; io.observe(el); });

		// Tree rings. Each ring wobbles a little more than the one inside it, like a real cross-section.
		(() => {
			const cv = document.getElementById('rings'), g = cv.getContext('2d');
			const still = matchMedia('(prefers-reduced-motion:reduce)').matches;
			const N = 64, GOLD = [13, 29, 47];
			let s = 5; const rnd = () => ((s = (s * 16807) % 2147483647) / 2147483647);
			const gaps = [], harm = [];
			for (let i = 0; i < N; i++) gaps.push(0.55 + rnd() * 0.9);
			for (let k = 2; k <= 7; k++) harm.push({ k, a: (0.5 + rnd()) / k, p: rnd() * 6.28, d: (rnd() - 0.5) * 0.09 });
			let W = 0, H = 0, mx = 0, my = 0, t0 = null;
			const size = () => { const d = Math.min(2, devicePixelRatio || 1); W = cv.clientWidth; H = cv.clientHeight; cv.width = W * d; cv.height = H * d; g.setTransform(d, 0, 0, d, 0, 0); };
			size(); addEventListener('resize', size);
			addEventListener('pointermove', (e) => { mx = e.clientX / innerWidth - 0.5; my = e.clientY / innerHeight - 0.5; });
			const frame = (now) => {
				if (t0 === null) t0 = now;
				const el = (now - t0) / 1000, grown = still ? N : Math.min(N, el * 9), breathe = still ? 0 : now / 5200;
				g.clearRect(0, 0, W, H);
				const narrow = W < 860, cx = W * (narrow ? 0.62 : 0.74) + mx * 20, cy = H * (narrow ? 0.22 : 0.45) + my * 14;
				const R = narrow ? W * 0.78 : Math.min(W * 0.36, H * 0.62), unit = R / gaps.reduce((a, b) => a + b, 0);
				let r = 0;
				for (let i = 0; i < N; i++) {
					r += gaps[i] * unit;
					const a = Math.max(0, Math.min(1, grown - i)); if (a <= 0) break;
					const gold = GOLD.includes(i), wob = 0.012 + (i / N) * 0.05;
					g.beginPath();
					for (let j = 0; j <= 140; j++) {
						const th = (j / 140) * 6.2832; let o = 0;
						for (const h of harm) o += h.a * Math.sin(h.k * th + h.p + i * h.d + breathe * (h.k % 2 ? 1 : -1) * 0.25);
						const rr = r * (1 + o * wob), x = cx + Math.cos(th) * rr * 1.06, y = cy + Math.sin(th) * rr * 0.94;
						j ? g.lineTo(x, y) : g.moveTo(x, y);
					}
					g.closePath();
					g.strokeStyle = gold ? 'rgba(212,184,102,' + 0.95 * a + ')' : 'rgba(243,235,219,' + (0.1 + 0.16 * ((i * 7) % 5) / 4) * a + ')';
					g.lineWidth = gold ? 1.8 : 0.6 + ((i * 3) % 4) * 0.35;
					g.stroke();
				}
				g.beginPath(); g.arc(cx, cy, 2.5, 0, 7); g.fillStyle = 'rgba(243,235,219,.8)'; g.fill();
				if (!still) requestAnimationFrame(frame);
			};
			requestAnimationFrame(frame);
		})();
	</script>
</body>
</html>
